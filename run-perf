def nearest_rank(values, percentile):
    if not values:
        raise ValueError("Percentile input must not be empty")
    if percentile <= 0 or percentile > 100:
        raise ValueError("Percentile must be greater than zero and at most 100")
    ordered = sorted(values)
    rank = math.ceil(percentile / 100 * len(ordered))
    return ordered[rank - 1]


class VsockListener:
    def __init__(self, port, path=None):
        self.port = port
        self.path = path
        self.listener = None
        self.connections = []
        self.thread = None
        self.running = False

    def start(self):
        try:
            family = socket.AF_UNIX if self.path else socket.AF_VSOCK
            address = self.path or (socket.VMADDR_CID_ANY, self.port)
            self.listener = socket.socket(family,
                                          socket.SOCK_STREAM)
            self.listener.bind(address)
            self.listener.listen(socket.SOMAXCONN)
            self.listener.settimeout(0.1)
        except OSError as error:
            if self.listener is not None:
                self.listener.close()
            endpoint = self.path or f"host vsock port {self.port}"
            raise RuntimeError(f"Cannot listen on {endpoint}: {error}")
        self.running = True
        self.thread = threading.Thread(target=self._accept, daemon=True)
        self.thread.start()

    def _accept(self):
        while self.running:
            try:
                connection, _ = self.listener.accept()
            except socket.timeout:
                continue
            except OSError:
                return
            self.connections.append(connection)

    def stop(self):
        self.running = False
        if self.listener is not None:
            self.listener.close()
        if self.thread is not None:
            self.thread.join(timeout=1)
        for connection in self.connections:
            connection.close()


class NetworkSender:
    def __init__(self, source_port, destination_port, payload_only=False,
                 source_address="127.0.0.1",
                 destination_address="127.0.0.1", broadcast=False):
        self.source_port = source_port
        self.destination_port = destination_port
        self.payload_only = payload_only
        self.source_address = source_address
        self.destination_address = destination_address
        self.broadcast = broadcast
        self.socket = None
        self.thread = None
        self.running = False

    def start(self):
        self.socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        if self.broadcast:
            self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        self.socket.bind((self.source_address, self.source_port))
        self.running = True
        self.thread = threading.Thread(target=self._send, daemon=True)
        self.thread.start()

    def _send(self):
        if self.payload_only:
            frame = bytes([0x42]) * 22
        else:
            frame = (bytes.fromhex("ffffffffffff02020202020288b5") +
                     bytes([0x42]) * 50)
        destination = (self.destination_address, self.destination_port)
        while self.running:
            try:
                self.socket.sendto(frame, destination)
            except OSError:
                if self.running:
                    continue
                return

    def stop(self):
        self.running = False
        if self.socket is not None:
            self.socket.close()
        if self.thread is not None:
            self.thread.join(timeout=1)


def parse_proc_stat(text):
    name_start = text.find("(")
    name_end = text.rfind(")")
    if name_start < 0 or name_end <= name_start:
        raise ValueError("Invalid proc stat record")
    fields = text[name_end + 2:].split()
    if len(fields) < 20:
        raise ValueError("Incomplete proc stat record")
    return {
        "name": text[name_start + 1:name_end],
        "ppid": int(fields[1]),
        "user_ticks": int(fields[11]),
        "kernel_ticks": int(fields[12]),
        "start_ticks": int(fields[19]),
    }


def parse_proc_status(text):
    values = {}
    for line in text.splitlines():
        name, separator, value = line.partition(":")
        if separator and name in {
                "voluntary_ctxt_switches", "nonvoluntary_ctxt_switches"}:
            values[name] = int(value.strip())
    return {
        "voluntary_context_switches": values.get(
            "voluntary_ctxt_switches", 0),
        "involuntary_context_switches": values.get(
            "nonvoluntary_ctxt_switches", 0),
    }


class ThreadAccounting:
    def __init__(self, executable):
        self.executable = os.path.realpath(shutil.which(executable) or executable)
        self.parent_pid = os.getpid()
        self.clock_ticks = os.sysconf("SC_CLK_TCK")
        self.records = {}
        self.stop_event = threading.Event()
        self.thread = None

    @staticmethod
    def _read(path):
        try:
            with open(path, encoding="utf-8") as proc_file:
                return proc_file.read()
        except (OSError, UnicodeError):
            return None

    def _descendants(self):
        descendants = set()
        pending = [self.parent_pid]
        while pending:
            parent = pending.pop()
            children = self._read(
                f"/proc/{parent}/task/{parent}/children")
            if children is None:
                continue
            for value in children.split():
                child = int(value)
                if child not in descendants:
                    descendants.add(child)
                    pending.append(child)
        return descendants

    def _matches_executable(self, pid):
        try:
            return os.path.samefile(self.executable, f"/proc/{pid}/exe")
        except OSError:
            return False

    def _sample(self):
        for pid in self._descendants():
            if not self._matches_executable(pid):
                continue
            try:
                tasks = os.scandir(f"/proc/{pid}/task")
            except OSError:
                continue
            with tasks:
                for task in tasks:
                    stat_text = self._read(f"{task.path}/stat")
                    status_text = self._read(f"{task.path}/status")
                    if stat_text is None or status_text is None:
                        continue
                    try:
                        stat = parse_proc_stat(stat_text)
                        switches = parse_proc_status(status_text)
                    except (TypeError, ValueError):
                        continue
                    tid = int(task.name)
                    key = (pid, tid, stat["start_ticks"])
                    self.records[key] = {
                        "pid": pid,
                        "tid": tid,
                        "name": stat["name"],
                        "user_ticks": stat["user_ticks"],
                        "kernel_ticks": stat["kernel_ticks"],
                        **switches,
                    }

    def _run(self):
        while not self.stop_event.is_set():
            self._sample()
            self.stop_event.wait(0.005)

    def start(self):
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def stop(self):
        self.stop_event.set()
        if self.thread is not None:
            self.thread.join(timeout=1)
        result = []
        for record in self.records.values():
            result.append({
                "pid": record["pid"],
                "tid": record["tid"],
                "name": record["name"],
                "user_cpu_ns": (
                    record["user_ticks"] * 1_000_000_000 // self.clock_ticks),
                "kernel_cpu_ns": (
                    record["kernel_ticks"] * 1_000_000_000 // self.clock_ticks),
                "voluntary_context_switches": record[
                    "voluntary_context_switches"],
                "involuntary_context_switches": record[
                    "involuntary_context_switches"],
            })
        return sorted(result, key=lambda item: (item["pid"], item["tid"]))


def unused_udp_port():
    udp_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    udp_socket.bind(("127.0.0.1", 0))
    port = udp_socket.getsockname()[1]
    udp_socket.close()
    return port


def has_effective_capability(capabilities, capability):
    if capabilities is None:
        return False
    for clause in capabilities.split():
        match = re.fullmatch(r"([^=+]+)[=+]([a-z]+)", clause)
        if match and capability in match.group(1).split(","):
            if "e" in match.group(2) and "p" in match.group(2):
                return True
    return False


def load_runner():
    path = os.path.join(ROOT, "run")
    loader = importlib.machinery.SourceFileLoader("vv_run_perf", path)
    spec = importlib.util.spec_from_loader("vv_run_perf", loader)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def create_disk_image(path, disk_type, size_mib):
    size = size_mib * 1024 * 1024
    if disk_type == "raw":
        with open(path, "wb") as disk_file:
            disk_file.truncate(size)
        return
    qemu_format = {"qcow2": "qcow2", "vhd": "vpc", "vhdx": "vhdx"}[
        disk_type]
    command = ["qemu-img", "create", "-f", qemu_format]
    if disk_type == "vhd":
        command += ["-o", "subformat=fixed"]
    command += [path, str(size)]
    try:
        subprocess.run(command, check=True, capture_output=True)
    except (OSError, subprocess.CalledProcessError) as error:
        raise RuntimeError(
            f"Cannot create {disk_type} performance disk: {error}") from error


def parse_results(output):
    samples = []
    rounds = set()
    common = None
    latency_records = {}
    for line in output.splitlines():
        if not line.startswith(LATENCY_PREFIX):
            continue
        try:
            fields = dict(item.split("=", 1) for item in
                          line[len(LATENCY_PREFIX):].split())
            round_number = int(fields["round"])
            sample_number = int(fields["sample"])
            latency_ns = int(fields["latency_ns"])
        except (KeyError, ValueError) as error:
            raise RuntimeError("Invalid latency sample record") from error
        if round_number <= 0 or sample_number <= 0 or latency_ns <= 0:
            raise RuntimeError("Latency sample values must be positive")
        records = latency_records.setdefault(round_number, {})
        if sample_number in records:
            raise RuntimeError("Duplicate latency sample identifier")
        records[sample_number] = latency_ns
    for line in output.splitlines():
        if not line.startswith(RESULT_PREFIX) or "error=" in line:
            continue
        try:
            fields = dict(item.split("=", 1) for item in
                          line[len(RESULT_PREFIX):].split())
        except ValueError as error:
            raise RuntimeError("Invalid performance result record") from error
        missing = RESULT_FIELDS - fields.keys()
        if missing:
            raise RuntimeError(
                f"Performance result missing {', '.join(sorted(missing))}")
        if fields["version"] != "3":
            raise RuntimeError(
                f"Unsupported performance result version {fields['version']}")
        try:
            numeric = {name: int(fields[name]) for name in (
                "round", "request_bytes", "iterations", "duration_ns",
                "queue_depth", "batch_size", "submissions", "completions",
                "notifications", "sample_every", "device_queues")}
        except ValueError as error:
            raise RuntimeError("Invalid numeric performance result field") from error
        round_number = numeric["round"]
        if round_number in rounds:
            raise RuntimeError(f"Duplicate performance round {round_number}")
        rounds.add(round_number)
        stable = {name: fields[name] for name in RESULT_FIELDS
                  if name not in {"round", "duration_ns"}}
        if common is None:
            common = stable
        elif stable != common:
            raise RuntimeError("Performance result settings changed between rounds")
        duration = numeric["duration_ns"]
        count = numeric["iterations"]
        if duration <= 0 or count <= 0:
            raise RuntimeError("Performance duration and iterations must be positive")
        if numeric["submissions"] <= 0 or numeric["completions"] <= 0:
            raise RuntimeError("Performance queue counts must be positive")
        if numeric["notifications"] < 0:
            raise RuntimeError("Performance notification count must not be negative")
        if numeric["device_queues"] <= 0:
            raise RuntimeError("Performance device queue count must be positive")
        try:
            negotiated_features = int(fields["features"], 0)
        except ValueError as error:
            raise RuntimeError("Invalid negotiated feature field") from error
        if fields["workload"] == "blk":
            if fields["operation"] not in {"blk_read", "blk_write"}:
                raise RuntimeError("Block result has an invalid operation")
            if fields["address_pattern"] not in {
                    "fixed", "sequential", "random"}:
                raise RuntimeError("Block result has an invalid address pattern")
            if (numeric["device_queues"] > 1 and
                    not negotiated_features & (1 << VIRTIO_BLK_F_MQ)):
                raise RuntimeError("Block multiqueue result lacks MQ")
        elif fields["workload"] == "net":
            if fields["operation"] not in {"net_tx", "net_rx"}:
                raise RuntimeError("Network result has an invalid operation")
            if fields["address_pattern"] != "none":
                raise RuntimeError("Nonblock result has an address pattern")
            if numeric["device_queues"] != 1:
                raise RuntimeError("Nonblock result has multiple device queues")
        elif fields["address_pattern"] != "none":
            raise RuntimeError("Nonblock result has an address pattern")
        elif numeric["device_queues"] != 1:
            raise RuntimeError("Nonblock result has multiple device queues")
        if fields["descriptor_layout"] == "indirect":
            if not negotiated_features & (1 << VIRTIO_F_INDIRECT_DESC):
                raise RuntimeError("Indirect result lacks descriptor feature")
        elif fields["descriptor_layout"] != "direct":
            raise RuntimeError("Performance result has an invalid descriptor layout")
        if fields["queue_format"] == "packed":
            if not negotiated_features & (1 << VIRTIO_F_RING_PACKED):
                raise RuntimeError("Packed result lacks packed ring feature")
        elif fields["queue_format"] != "split":
            raise RuntimeError("Performance result has an invalid queue format")
        if fields["notification_policy"] == "event_idx":
            if not negotiated_features & (1 << VIRTIO_F_EVENT_IDX):
                raise RuntimeError("Event index result lacks event index feature")
        elif fields["notification_policy"] == "always":
            if numeric["notifications"] == 0:
                raise RuntimeError("Always notify result lacks notifications")
        else:
            raise RuntimeError("Performance result has an invalid notification policy")
        operations_per_second = count * 1_000_000_000 / duration
        sample = {
            "experiment_class": fields["experiment"],
            "changed_dimension": (None if fields["changed"] == "none"
                                  else fields["changed"]),
            "workload": fields["workload"],
            "operation": fields["operation"],
            "address_pattern": fields["address_pattern"],
            "round": round_number,
            "request_bytes": numeric["request_bytes"],
            "iterations": count,
            "duration_ns": duration,
            "queue_format": fields["queue_format"],
            "descriptor_layout": fields["descriptor_layout"],
            "notification_policy": fields["notification_policy"],
            "queue_depth": numeric["queue_depth"],
            "batch_size": numeric["batch_size"],
            "device_queues": numeric["device_queues"],
            "submissions": numeric["submissions"],
            "completions": numeric["completions"],
            "notifications": numeric["notifications"],
            "timing_mode": fields["timing_mode"],
            "clock_source": fields["clock_source"],
            "sample_every": numeric["sample_every"],
            "negotiated_features": fields["features"],
            "operations_per_second": operations_per_second,
            "mean_service_time_ns": duration / count,
            "notifications_per_submission": (
                numeric["notifications"] / numeric["submissions"]),
        }
        if fields["operation"] in PAYLOAD_RATE_OPERATIONS:
            sample["payload_bytes_per_second"] = (
                operations_per_second * numeric["request_bytes"])
        samples.append(sample)
    for sample in samples:
        records = latency_records.get(sample["round"], {})
        if sample["timing_mode"] == "latency":
            if sample["clock_source"] != "RDTSCP":
                raise RuntimeError("Latency result has an invalid clock source")
            if sample["sample_every"] <= 0 or not records:
                raise RuntimeError("Latency result lacks sample records")
            expected = (1 + (sample["iterations"] - 1) //
                        sample["sample_every"])
            if set(records) != set(range(1, expected + 1)):
                raise RuntimeError("Latency result sample identifiers are invalid")
            values = [records[number] for number in range(1, expected + 1)]
            sample["latency_samples_ns"] = values
            sample["latency_sample_count"] = len(values)
            sample["latency_p50_ns"] = nearest_rank(values, 50)
            sample["latency_p90_ns"] = nearest_rank(values, 90)
            sample["latency_p99_ns"] = nearest_rank(values, 99)
            sample["latency_p999_ns"] = nearest_rank(values, 99.9)
        elif sample["timing_mode"] == "throughput":
            if sample["clock_source"] != "CLOCK_MONOTONIC_RAW":
                raise RuntimeError("Throughput result has an invalid clock source")
            if sample["sample_every"] != 0:
                raise RuntimeError("Throughput result has a sampling interval")
        else:
            raise RuntimeError("Performance result has an invalid timing mode")
    unknown_rounds = latency_records.keys() - rounds
    if unknown_rounds:
        raise RuntimeError("Latency sample references an unknown round")
    return samples


def summarize(samples):
    operation_rates = [sample["operations_per_second"] for sample in samples]
    median_rate = statistics.median(operation_rates)
    median_absolute_deviation = statistics.median(
        abs(rate - median_rate) for rate in operation_rates)
    total_requests = sum(sample["iterations"] for sample in samples)
    total_duration_ns = sum(sample["duration_ns"] for sample in samples)
    total_submissions = sum(sample["submissions"] for sample in samples)
    total_notifications = sum(sample["notifications"] for sample in samples)
    combined_rate = total_requests * 1_000_000_000 / total_duration_ns
    summary = {
        "total_requests": total_requests,
        "total_duration_ns": total_duration_ns,
        "operations_per_second": combined_rate,
        "operations_per_second_median": median_rate,
        "operations_per_second_mad": median_absolute_deviation,
        "operations_per_second_mad_percent": (
            median_absolute_deviation / median_rate * 100),
        "operations_per_second_min": min(operation_rates),
        "operations_per_second_max": max(operation_rates),
        "mean_service_time_ns": total_duration_ns / total_requests,
        "notifications_per_submission": (
            total_notifications / total_submissions),
    }
    if "payload_bytes_per_second" in samples[0]:
        summary["payload_bytes_per_second"] = (
            combined_rate * samples[0]["request_bytes"])
    if "latency_samples_ns" in samples[0]:
        latency_values = [value for sample in samples
                          for value in sample["latency_samples_ns"]]
        summary["latency_sample_count"] = len(latency_values)
        summary["latency_p50_ns"] = nearest_rank(latency_values, 50)
        summary["latency_p90_ns"] = nearest_rank(latency_values, 90)
        summary["latency_p99_ns"] = nearest_rank(latency_values, 99)
        summary["latency_p999_ns"] = nearest_rank(latency_values, 99.9)
    return summary


def get_version(path):
    try:
        result = subprocess.run(
            [path, "--version"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    text = result.stdout.strip()
    if text:
        return text.splitlines()[0]
    if result.returncode != 0:
        return None
    text = result.stderr.strip()
    return text.splitlines()[0] if text else None


def get_binary_sha256(path):
    resolved = shutil.which(path) or path
    digest = hashlib.sha256()
    try:
        with open(resolved, "rb") as binary:
            for chunk in iter(lambda: binary.read(1024 * 1024), b""):
                digest.update(chunk)
    except OSError:
        return None
    return digest.hexdigest()


def get_processor_model():
    try:
        with open("/proc/cpuinfo", encoding="utf-8") as cpuinfo:
            for line in cpuinfo:
                name, separator, value = line.partition(":")
                if separator and name.strip() in {"model name", "Hardware"}:
                    return value.strip()
    except OSError:
        pass
    return platform.processor() or None


def build_guest():
    result = subprocess.run(
        ["make", "perf-initramfs"], cwd=ROOT,
        capture_output=True, text=True)
    if result.returncode:
        sys.stderr.write(result.stdout)
        sys.stderr.write(result.stderr)
    return result.returncode


def run_vmm(cmd, spawn, rounds):
    try:
        result = subprocess.run(cmd, **spawn)
        raw_output = result.stdout + result.stderr
    except subprocess.TimeoutExpired as error:
        raw_output = (error.stdout or b"") + (error.stderr or b"")
    output = raw_output.decode(errors="replace")
    samples = parse_results(output)
    if len(samples) != rounds:
        error = re.search(r"VVPERF error=(\w+)", output)
        detail = error.group(1) if error else "missing guest results"
        raise RuntimeError(f"Performance run failed with {detail}\n{output}")
    return samples


def create_work_directory(work_dir):
    try:
        return tempfile.TemporaryDirectory(prefix="vvperf.", dir=work_dir)
    except OSError as error:
        location = os.path.abspath(work_dir or tempfile.gettempdir())
        raise RuntimeError(
            f"Cannot create performance work directory in {location}: "
            f"{error}") from error


def run_guest(args, runner):
    backend = runner.detect_vmm(args.vmm)
    if args.device not in BACKEND_DEVICES.get(backend.name, set()):
        raise RuntimeError(
            f"{backend.name} does not provide virtio-{args.device}")
    kernel = args.kernel or runner.fetch_kernel()
    initramfs = os.path.join(ROOT, "target", "perf-initramfs.cpio.gz")
    with create_work_directory(args.work_dir) as temp_dir:
        args.work_dir_used = os.path.realpath(os.path.dirname(temp_dir))
        disk = os.path.join(temp_dir, "disk" + DISK_SUFFIXES[args.disk_type])
        create_disk_image(disk, args.disk_type, args.disk_size)
        cmdline = (
            f"console={backend.console_device} "
            f"initcall_blacklist={DEVICE_INITCALL[args.device]} "
            f"vv.perf_device={args.device} "
            f"vv.perf_iterations={args.iterations} vv.perf_rounds={args.rounds} "
            f"vv.perf_warmup={args.warmup} "
            f"vv.perf_queue_depth={args.queue_depth} "
            f"vv.perf_batch_size={args.batch_size} "
            f"vv.perf_device_queues={args.device_queues} "
            f"vv.perf_descriptor_layout={args.descriptor_layout} "
            f"vv.perf_queue_format={args.queue_format} "
            f"vv.perf_notification_policy={args.notification_policy} "
            f"vv.perf_timing_mode={args.timing_mode} "
            f"vv.perf_sample_every={args.sample_every} "
            f"vv.perf_block_operation={args.block_operation} "
            f"vv.perf_block_pattern={args.block_pattern} "
            f"vv.perf_block_request_size={args.block_request_size} "
            f"vv.perf_net_operation={args.net_operation} "
            f"vv.perf_net_header_size="
            f"{12 if backend.name in {'ch', 'openvmm'} else 10} "
            f"vv.perf_experiment={args.experiment_class} "
            f"vv.perf_changed={args.changed_dimension}")
        opts = {
            "blk_queues": args.device_queues,
            "blk_iommu": False,
            "cpus": max(args.cpus, args.device_queues),
            "direct": args.direct,
            "exit_on_guest_end": True, "fuzz_device": args.device,
            "io_engine": args.io_engine, "memory": args.memory,
            "net_queues": 2, "packed": args.queue_format == "packed",
        }
        network_sender = None
        if args.device == "net" and args.net_operation == "receive":
            if backend.name == "ch":
                capabilities = runner._getcap(args.vmm)
                if not has_effective_capability(capabilities,
                                                "cap_net_admin"):
                    raise RuntimeError(
                        "Cloud Hypervisor network receive requires "
                        "cap_net_admin+ep on the VMM binary")
            if backend.name not in {"ch", "openvmm", "qemu"}:
                raise RuntimeError(
                    f"{backend.name} does not provide network receive injection")
            source_port = unused_udp_port()
            destination_port = unused_udp_port()
            while destination_port == source_port:
                destination_port = unused_udp_port()
            opts["net_rx_port"] = destination_port
            if backend.name == "qemu":
                opts["net_rx_source_port"] = source_port
            if backend.name == "ch":
                subnet = os.getpid() % 254 + 1
                opts["net_rx_tap"] = f"vvperf{os.getpid():x}"
                opts["net_rx_ip"] = f"198.18.{subnet}.1"
                network_sender = NetworkSender(
                    source_port, destination_port, payload_only=True,
                    source_address="0.0.0.0",
                    destination_address=f"198.18.{subnet}.255",
                    broadcast=True)
            else:
                network_sender = NetworkSender(
                    source_port, destination_port,
                    payload_only=backend.name == "openvmm")
        if backend.name == "qemu" and args.timing_mode == "latency":
            opts["cpu_model"] = "host"
        cmd = backend.build_cmd(kernel, initramfs, disk, cmdline, opts)
        if args.strace_profile:
            cmd = ["strace", "-f", "-c", "-o",
                   os.path.abspath(args.strace_profile), "--", *cmd]
        spawn = {"capture_output": True, "timeout": args.timeout}
        master_fd = None
        slave_fd = None
        if backend.name == "openvmm":
            master_fd, slave_fd = pty.openpty()
            spawn["stdin"] = slave_fd
            spawn["preexec_fn"] = runner._ctty_preexec(
                os.ttyname(slave_fd).encode())
        else:
            spawn["stdin"] = subprocess.DEVNULL
        vsock_listener = None
        if args.device == "vsock" and backend.name == "qemu":
            vsock_listener = VsockListener(5678)
            vsock_listener.start()
        elif args.device == "vsock" and backend.name == "ch":
            vsock_path = disk.rsplit(".", 1)[0] + ".vsock_5678"
            vsock_listener = VsockListener(5678, path=vsock_path)
            vsock_listener.start()
        try:
            if network_sender is not None:
                network_sender.start()
            accounting = (ThreadAccounting(args.vmm)
                          if args.thread_accounting else None)
            if accounting is not None:
                accounting.start()
            args.measurement_start_unix_ns = time.time_ns()
            try:
                samples = run_vmm(cmd, spawn, args.rounds)
            finally:
                args.measurement_stop_unix_ns = time.time_ns()
                if accounting is not None:
                    args.thread_accounting_data = accounting.stop()
        finally:
            if network_sender is not None:
                network_sender.stop()
            if vsock_listener is not None:
                vsock_listener.stop()
            if master_fd is not None:
                os.close(master_fd)
            if slave_fd is not None:
                os.close(slave_fd)
    return backend, samples, kernel


def make_report(args, backend, samples, kernel):
    sample = samples[0]
    vmm = {"backend": backend.name, "path": os.path.abspath(args.vmm),
           "version": get_version(args.vmm),
           "sha256": get_binary_sha256(args.vmm),
           "process_mode": ("single" if backend.name == "openvmm"
                            else "default")}
    if backend.name == "qemu":
        vmm["machine"] = ("virt" if platform.machine() == "aarch64"
                          else "default")
        vmm["accelerator"] = "kvm"
        vmm["cpu_model"] = ("host" if args.timing_mode == "latency"
                            else "default")
    if sample["workload"] == "blk":
        direct = args.direct or (
            backend.name == "openvmm" and args.io_engine == "aio")
        resource = {"type": "file", "format": args.disk_type,
                    "direct": direct,
                    "disk_size_mib": args.disk_size,
                    "io_engine": args.io_engine,
                    "work_dir": getattr(
                        args, "work_dir_used",
                        os.path.realpath(
                            args.work_dir or tempfile.gettempdir()))}
    elif sample["workload"] == "net":
        endpoints = {"qemu": "user", "ch": "tap", "openvmm": "consomme"}
        resource = {"type": "network",
                    "endpoint": ("socket" if sample["operation"] == "net_rx"
                                 and backend.name == "qemu"
                                 else endpoints[backend.name])}
    elif sample["workload"] == "rng":
        source = ("default" if backend.name == "openvmm" else "/dev/urandom")
        resource = {"type": "rng", "source": source}
    else:
        endpoints = {"qemu": "vhost", "ch": "unix"}
        resource = {"type": "vsock", "endpoint": endpoints[backend.name]}
    return {
        "schema_version": 3,
        "experiment": {
            "class": sample["experiment_class"],
            "changed_dimension": sample["changed_dimension"],
        },
        "host": {"machine": platform.machine(), "system": platform.system(),
                 "kernel": platform.release(),
                 "processor": get_processor_model()},
        "guest": {"kernel": os.path.abspath(kernel)},
        "vmm": vmm,
        "execution": {"boot_id": str(uuid.uuid4()),
                      "cpus": max(args.cpus, args.device_queues),
                      "memory": args.memory,
                      "iterations": args.iterations, "rounds": args.rounds,
                      "warmup": args.warmup,
                      "measurement_start_unix_ns": getattr(
                          args, "measurement_start_unix_ns", None),
                      "measurement_stop_unix_ns": getattr(
                          args, "measurement_stop_unix_ns", None)},
        "queue": {"transport": "pci", "format": sample["queue_format"],
                  "descriptor_layout": sample["descriptor_layout"],
                  "notification_policy": sample["notification_policy"],
                  "depth": sample["queue_depth"],
                  "batch_size": sample["batch_size"],
                  "device_queues": sample["device_queues"],
                  "negotiated_features": sample["negotiated_features"]},
        "workload": {"device": sample["workload"],
                     "operation": sample["operation"],
                     "address_pattern": sample["address_pattern"],
                     "request_bytes": sample["request_bytes"]},
        "backend": resource,
        "instrumentation": {
            "enabled": (args.strace_profile is not None or
                        args.thread_accounting),
            "strace_enabled": args.strace_profile is not None,
            "strace_profile": (os.path.abspath(args.strace_profile)
                               if args.strace_profile else None),
            "thread_accounting_enabled": args.thread_accounting,
            "thread_accounting": getattr(
                args, "thread_accounting_data", None),
        },
        "timing": {"mode": sample["timing_mode"],
                   "clock_source": sample["clock_source"],
                   "sample_every": sample["sample_every"]},
        "samples": samples,
        "summary": summarize(samples),
    }


def compatibility_mismatches(baseline, candidate):
    """Return fields that prevent a valid report comparison."""
    ignored = {"samples", "summary", "execution.boot_id",
               "execution.measurement_start_unix_ns",
               "execution.measurement_stop_unix_ns",
               "instrumentation.strace_profile",
               "instrumentation.thread_accounting"}
    fixed_vmm = {"accelerator", "backend", "cpu_model", "machine",
                 "process_mode"}
    mismatches = []
    experiment = baseline.get("experiment", {})
    if candidate.get("experiment") != experiment:
        return ["experiment"]
    experiment_class = experiment.get("class")
    if experiment_class not in {"queue", "frontend", "backend"}:
        raise RuntimeError("Performance report has invalid experiment class")
    changed = experiment.get("changed_dimension")
    allowed = None
    if changed:
        section_names = {"queue": "queue", "frontend": "workload",
                         "backend": "backend"}
        section_name = section_names[experiment_class]
        if (changed not in baseline.get(section_name, {}) or
                changed not in candidate.get(section_name, {})):
            raise RuntimeError(
                "Performance report has invalid changed dimension")
        if experiment_class == "queue":
            allowed = f"queue.{changed}"
        elif experiment_class == "frontend":
            allowed = f"workload.{changed}"
        else:
            allowed = f"backend.{changed}"

    def compare(path, left, right):
        if path in ignored or path == allowed:
            return
        if path == "vmm":
            for name in fixed_vmm:
                if left.get(name) != right.get(name):
                    mismatches.append(f"vmm.{name}")
            return
        if isinstance(left, dict) and isinstance(right, dict):
            for name in sorted(left.keys() | right.keys()):
                compare(f"{path}.{name}" if path else name,
                        left.get(name), right.get(name))
        elif left != right:
            mismatches.append(path)

    compare("", baseline, candidate)
    return mismatches


def compare_reports(baseline, candidate):
    for report in (baseline, candidate):
        if report.get("schema_version") != 3:
            raise RuntimeError("Unsupported performance report schema")
        for section in ("experiment", "vmm", "workload", "summary"):
            if not isinstance(report.get(section), dict):
                raise RuntimeError(
                    f"Performance report lacks {section} section")
    mismatches = compatibility_mismatches(baseline, candidate)
    if mismatches:
        raise RuntimeError(
            "Incompatible performance reports: " + ", ".join(mismatches))
    try:
        baseline_summary = baseline["summary"]
        candidate_summary = candidate["summary"]
        baseline_rate = baseline_summary["operations_per_second"]
        candidate_rate = candidate_summary["operations_per_second"]
        baseline_range = [
            baseline_summary["operations_per_second_min"],
            baseline_summary["operations_per_second_max"],
        ]
        candidate_range = [
            candidate_summary["operations_per_second_min"],
            candidate_summary["operations_per_second_max"],
        ]
    except (KeyError, TypeError) as error:
        raise RuntimeError("Performance report lacks throughput summary") from error
    numeric_values = [baseline_rate, candidate_rate, *baseline_range,
                      *candidate_range]
    if (not all(isinstance(value, (int, float)) for value in numeric_values) or
            not all(math.isfinite(value) for value in numeric_values)):
        raise RuntimeError("Performance report throughput summary is invalid")
    if baseline_rate <= 0 or candidate_rate <= 0:
        raise RuntimeError("Performance report operation rate must be positive")
    for rate, round_range in ((baseline_rate, baseline_range),
                              (candidate_rate, candidate_range)):
        if (round_range[0] <= 0 or round_range[0] > round_range[1] or
                not round_range[0] <= rate <= round_range[1]):
            raise RuntimeError("Performance report round range is invalid")
    ranges_overlap = (
        baseline_range[0] <= candidate_range[1] and
        candidate_range[0] <= baseline_range[1])
    return {
        "comparison_version": 1,
        "metric": "operations_per_second",
        "baseline": {
            "value": baseline_rate,
            "round_range": baseline_range,
            "relative_spread_percent": (
                (baseline_range[1] - baseline_range[0]) / baseline_rate * 100),
            "vmm": baseline["vmm"],
            "workload": baseline["workload"],
        },
        "candidate": {
            "value": candidate_rate,
            "round_range": candidate_range,
            "relative_spread_percent": (
                (candidate_range[1] - candidate_range[0]) / candidate_rate * 100),
            "vmm": candidate["vmm"],
            "workload": candidate["workload"],
        },
        "change_percent": (candidate_rate / baseline_rate - 1) * 100,
        "round_ranges_overlap": ranges_overlap,
        "experiment": baseline["experiment"],
    }


def load_report(path):
    try:
        with open(path, encoding="utf-8") as report_file:
            report = json.load(report_file)
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Cannot read performance report {path}: {error}") from error
    if not isinstance(report, dict):
        raise RuntimeError(f"Performance report {path} must contain an object")
    return report


def format_comparison(comparison):
    baseline = comparison["baseline"]
    candidate = comparison["candidate"]
    overlap = "yes" if comparison["round_ranges_overlap"] else "no"
    lines = [
        "virtio performance comparison",
        "",
        f"Baseline VMM: {baseline['vmm']['path']}",
        f"Candidate VMM: {candidate['vmm']['path']}",
    ]
    if baseline["workload"]["device"] == "blk":
        lines += [
            ("Baseline operation: " +
             baseline["workload"]["operation"].removeprefix("blk_")),
            ("Candidate operation: " +
             candidate["workload"]["operation"].removeprefix("blk_")),
            ("Baseline address pattern: " +
             baseline["workload"]["address_pattern"]),
            ("Candidate address pattern: " +
             candidate["workload"]["address_pattern"]),
        ]
    lines += [
        f"Baseline:     {baseline['value']:.2f} operations/s",
        f"Candidate:    {candidate['value']:.2f} operations/s",
        f"Change:       {comparison['change_percent']:+.2f}%",
        (f"Baseline range:  {baseline['round_range'][0]:.2f} to "
         f"{baseline['round_range'][1]:.2f} operations/s"),
        f"Baseline spread: {baseline['relative_spread_percent']:.2f}%",
        (f"Candidate range: {candidate['round_range'][0]:.2f} to "
         f"{candidate['round_range'][1]:.2f} operations/s"),
        f"Candidate spread: {candidate['relative_spread_percent']:.2f}%",
        f"Ranges overlap:  {overlap}",
    ]
    return "\n".join(lines)


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="Measure virtio request throughput")
    parser.add_argument("-m", "--vmm", metavar="PATH")
    parser.add_argument("--compare", nargs=2,
                        metavar=("BASELINE", "CANDIDATE"))
    parser.add_argument("--device", choices=tuple(DEVICE_INITCALL), default="blk")
    parser.add_argument("-k", "--kernel", metavar="PATH")
    parser.add_argument("-n", "--iterations", type=int, default=10000)
    parser.add_argument("--rounds", type=int, default=5)
    parser.add_argument("--warmup", type=int, default=1000)
    parser.add_argument("--queue-depth", type=int,
                        choices=(1, 2, 4, 8, 16, 32),
                        default=1)
    parser.add_argument("--batch-size", type=int, choices=(1, 4, 8, 16, 32),
                        default=1)
    parser.add_argument("--device-queues", type=int, choices=(1, 2, 4, 8, 16),
                        default=1)
    parser.add_argument("--descriptor-layout", choices=("direct", "indirect"),
                        default="direct")
    parser.add_argument("--queue-format", choices=("split", "packed"),
                        default="split")
    parser.add_argument("--notification-policy", choices=("always", "event_idx"),
                        default="always")
    parser.add_argument("--timing-mode", choices=("throughput", "latency"),
                        default="throughput")
    parser.add_argument("--sample-every", type=int, default=10, metavar="N")
    parser.add_argument("--block-operation", choices=("read", "write"),
                        default="read")
    parser.add_argument("--block-pattern",
                        choices=("fixed", "sequential", "random"),
                        default="fixed")
    parser.add_argument("--block-request-size", type=int,
                        choices=(512, 1024, 2048, 4096), default=4096,
                        metavar="BYTES")
    parser.add_argument("--net-operation", choices=("transmit", "receive"),
                        default="transmit")
    parser.add_argument("--cpus", type=int, default=1)
    parser.add_argument("--memory", default="256M")
    parser.add_argument("--disk-size", type=int, default=64, metavar="MIB")
    parser.add_argument("--work-dir", metavar="PATH")
    parser.add_argument("-d", "--disk-type", choices=DISK_FORMATS,
                        default="raw")
    parser.add_argument("--timeout", type=int, default=60)
    parser.add_argument("--io-engine", choices=("default", "io_uring", "aio", "sync"),
                        default="default")
    parser.add_argument("--direct", action="store_true")
    parser.add_argument("--strace-profile", metavar="PATH")
    parser.add_argument("--thread-accounting", action="store_true")
    parser.add_argument("--experiment-class",
                        choices=("queue", "frontend", "backend"),
                        default="queue")
    parser.add_argument("--changed-dimension", default="none", metavar="NAME")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--format", choices=("human", "json"), default="human")
    parser.add_argument("-o", "--output", metavar="PATH")
    args = parser.parse_args(argv)
    if args.compare and args.vmm:
        parser.error("--compare cannot be used with --vmm")
    if not args.compare and not args.vmm:
        parser.error("--vmm is required unless --compare is used")
    if args.compare and args.strace_profile:
        parser.error("--strace-profile cannot be used with --compare")
    if args.compare and args.thread_accounting:
        parser.error("--thread-accounting cannot be used with --compare")
    for name in ("iterations", "rounds", "warmup", "sample_every", "cpus",
                 "disk_size", "timeout"):
        if getattr(args, name) < 1:
            parser.error(f"--{name.replace('_', '-')} must be positive")
    if args.batch_size > args.queue_depth:
        parser.error("--batch-size must not exceed --queue-depth")
    if args.device != "blk" and (args.block_operation != "read" or
                                 args.block_pattern != "fixed" or
                                 args.block_request_size != 4096 or
                                 args.disk_type != "raw"):
        parser.error("block options require --device blk")
    if args.device != "net" and args.net_operation != "transmit":
        parser.error("network operation requires --device net")
    if args.device != "blk" and args.device_queues != 1:
        parser.error("multiple device queues require --device blk")
    if args.queue_format == "packed" and args.notification_policy == "event_idx":
        parser.error("event index notification policy requires a split queue")
    return args


def format_human(report, verbose=False):
    workload = report["workload"]
    samples = report["samples"]
    summary = report["summary"]
    sample = samples[0]
    operation_rate = summary["operations_per_second"]
    round_rates = [item["operations_per_second"] for item in samples]
    request_size = sample["request_bytes"]
    if request_size >= 1024 and request_size % 1024 == 0:
        request_size_text = f"{request_size // 1024} KiB"
    else:
        request_size_text = f"{request_size} bytes"
    label = DEVICE_LABEL[workload["device"]]
    if workload["device"] == "blk" and workload["operation"] == "blk_write":
        label = "block write"
    elif workload["operation"] == "net_rx":
        label = "network receive"
    lines = [
        f"virtio {label} {report['timing']['mode']}",
        "",
        f"Request size:  {request_size_text}",
        f"Operation:     {workload['operation'].removeprefix('blk_')}",
        f"Queue depth:   {report['queue']['depth']}",
        f"Queue format:  {report['queue']['format']}",
        f"Device queues: {report['queue']['device_queues']}",
        f"Descriptors:   {report['queue']['descriptor_layout']}",
        f"Notifications: {report['queue']['notification_policy']}",
        f"Batch size:    {report['queue']['batch_size']}",
        f"Requests:      {summary['total_requests']}",
        f"Operation rate: {operation_rate:.2f} operations/s",
        (f"Median rate:    {summary['operations_per_second_median']:.2f} "
         "operations/s"),
        (f"Dispersion:     {summary['operations_per_second_mad']:.2f} "
         "operations/s MAD, "
         f"{summary['operations_per_second_mad_percent']:.2f}%"),
        (f"Round range:    {min(round_rates):.2f} to "
         f"{max(round_rates):.2f} operations/s"),
        (f"Mean service:  {summary['mean_service_time_ns'] / 1000:.2f} "
         "us per operation"),
        (f"Notify ratio:  {summary['notifications_per_submission']:.4f} "
         "per submission"),
    ]
    if workload["device"] == "blk":
        lines.insert(5, f"Address pattern: {workload['address_pattern']}")
    if "payload_bytes_per_second" in summary:
        lines.append(
            f"Payload rate: {summary['payload_bytes_per_second'] / (1024 * 1024):.2f} MiB/s")
    if "latency_p50_ns" in summary:
        lines += [
            f"Latency samples: {summary['latency_sample_count']}",
            f"Latency p50:  {summary['latency_p50_ns']} ns",
            f"Latency p90:  {summary['latency_p90_ns']} ns",
            f"Latency p99:  {summary['latency_p99_ns']} ns",
            f"Latency p99.9: {summary['latency_p999_ns']} ns",
        ]
    if verbose:
        lines += [
            "",
            f"VMM:           {report['vmm']['backend']}",
            f"Binary:        {report['vmm']['path']}",
            f"Warmup:        {report['execution']['warmup']} requests",
            f"Rounds:        {len(samples)}",
        ]
        if report["vmm"]["version"]:
            lines.append(f"Version:       {report['vmm']['version']}")
        lines += [
            "",
            "Round  Requests  Elapsed s  Operations/s",
        ]
        for item in samples:
            lines.append(
                f"{item['round']:>5}  {item['iterations']:>8}  "
                f"{item['duration_ns'] / 1_000_000_000:>9.3f}  "
                f"{item['operations_per_second']:>12.2f}")
    return "\n".join(lines)


def main(argv=None):
    args = parse_args(argv)
    if args.compare:
        try:
            baseline = load_report(args.compare[0])
            candidate = load_report(args.compare[1])
            comparison = compare_reports(baseline, candidate)
        except RuntimeError as error:
            sys.exit(str(error))
        encoded = json.dumps(comparison, indent=2) + "\n"
        if args.output:
            with open(args.output, "w", encoding="utf-8") as output_file:
                output_file.write(encoded)
        if args.format == "json":
            print(encoded, end="")
        else:
            print(format_comparison(comparison))
        return 0
    build_result = build_guest()
    if build_result:
        return build_result
    runner = load_runner()
    try:
        backend, samples, kernel = run_guest(args, runner)
    except RuntimeError as error:
        sys.exit(str(error))
    report = make_report(args, backend, samples, kernel)
    encoded = json.dumps(report, indent=2) + "\n"
    if args.output:
        with open(args.output, "w", encoding="utf-8") as output_file:
            output_file.write(encoded)
    if args.format == "json":
        print(encoded, end="")
    else:
        print(format_human(report, args.verbose))
    return 0


if __name__ == "__main__":
    sys.exit(main())
