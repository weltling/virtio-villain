"""Run virtio performance measurements in one guest boot."""

import argparse
import importlib.machinery
import importlib.util
import json
import math
import os
import platform
import pty
import re
import socket
import subprocess
import sys
import tempfile
import threading

ROOT = os.path.dirname(os.path.abspath(__file__))
DEVICE_INITCALL = {
    "blk": "virtio_blk_init",
    "net": "virtio_net_driver_init",
    "rng": "virtio_rng_driver_init",
    "vsock": "virtio_vsock_init",
}
DEVICE_LABEL = {
    "blk": "block read",
    "net": "network transmit",
    "rng": "entropy fill",
    "vsock": "socket connection round trip",
}
BACKEND_DEVICES = {
    "ch": {"blk", "net", "rng", "vsock"},
    "qemu": {"blk", "net", "rng", "vsock"},
    "openvmm": {"blk", "net", "rng"},
}
PAYLOAD_RATE_WORKLOADS = {"blk", "rng"}
RESULT_PREFIX = "VVPERF "
RESULT_FIELDS = {
    "version", "experiment", "changed", "workload", "operation", "round",
    "request_bytes", "iterations", "duration_ns", "queue_format",
    "queue_depth", "batch_size", "submissions", "completions",
    "notifications", "timing_mode", "clock_source", "features",
}


class VsockListener:
    def __init__(self, port, path=None):
        self.port = port
        self.path = path
        self.listener = None
        self.connections = []
        self.thread = None
        self.running = False

    def start(self):
        try:
            family = socket.AF_UNIX if self.path else socket.AF_VSOCK
            address = self.path or (socket.VMADDR_CID_ANY, self.port)
            self.listener = socket.socket(family,
                                          socket.SOCK_STREAM)
            self.listener.bind(address)
            self.listener.listen(socket.SOMAXCONN)
            self.listener.settimeout(0.1)
        except OSError as error:
            if self.listener is not None:
                self.listener.close()
            endpoint = self.path or f"host vsock port {self.port}"
            raise RuntimeError(f"Cannot listen on {endpoint}: {error}")
        self.running = True
        self.thread = threading.Thread(target=self._accept, daemon=True)
        self.thread.start()

    def _accept(self):
        while self.running:
            try:
                connection, _ = self.listener.accept()
            except socket.timeout:
                continue
            except OSError:
                return
            self.connections.append(connection)

    def stop(self):
        self.running = False
        if self.listener is not None:
            self.listener.close()
        if self.thread is not None:
            self.thread.join(timeout=1)
        for connection in self.connections:
            connection.close()


def load_runner():
    path = os.path.join(ROOT, "run")
    loader = importlib.machinery.SourceFileLoader("vv_run_perf", path)
    spec = importlib.util.spec_from_loader("vv_run_perf", loader)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def parse_results(output):
    samples = []
    rounds = set()
    common = None
    for line in output.splitlines():
        if not line.startswith(RESULT_PREFIX) or "error=" in line:
            continue
        try:
            fields = dict(item.split("=", 1) for item in
                          line[len(RESULT_PREFIX):].split())
        except ValueError as error:
            raise RuntimeError("Invalid performance result record") from error
        missing = RESULT_FIELDS - fields.keys()
        if missing:
            raise RuntimeError(
                f"Performance result missing {', '.join(sorted(missing))}")
        if fields["version"] != "3":
            raise RuntimeError(
                f"Unsupported performance result version {fields['version']}")
        try:
            numeric = {name: int(fields[name]) for name in (
                "round", "request_bytes", "iterations", "duration_ns",
                "queue_depth", "batch_size", "submissions", "completions",
                "notifications")}
        except ValueError as error:
            raise RuntimeError("Invalid numeric performance result field") from error
        round_number = numeric["round"]
        if round_number in rounds:
            raise RuntimeError(f"Duplicate performance round {round_number}")
        rounds.add(round_number)
        stable = {name: fields[name] for name in RESULT_FIELDS
                  if name not in {"round", "duration_ns"}}
        if common is None:
            common = stable
        elif stable != common:
            raise RuntimeError("Performance result settings changed between rounds")
        duration = numeric["duration_ns"]
        count = numeric["iterations"]
        if duration <= 0 or count <= 0:
            raise RuntimeError("Performance duration and iterations must be positive")
        queue_counts = (numeric["submissions"], numeric["completions"],
                        numeric["notifications"])
        if any(value <= 0 for value in queue_counts):
            raise RuntimeError("Performance queue counts must be positive")
        operations_per_second = count * 1_000_000_000 / duration
        sample = {
            "experiment_class": fields["experiment"],
            "changed_dimension": (None if fields["changed"] == "none"
                                  else fields["changed"]),
            "workload": fields["workload"],
            "operation": fields["operation"],
            "round": round_number,
            "request_bytes": numeric["request_bytes"],
            "iterations": count,
            "duration_ns": duration,
            "queue_format": fields["queue_format"],
            "queue_depth": numeric["queue_depth"],
            "batch_size": numeric["batch_size"],
            "submissions": numeric["submissions"],
            "completions": numeric["completions"],
            "notifications": numeric["notifications"],
            "timing_mode": fields["timing_mode"],
            "clock_source": fields["clock_source"],
            "negotiated_features": fields["features"],
            "operations_per_second": operations_per_second,
            "mean_service_time_ns": duration / count,
            "notifications_per_submission": (
                numeric["notifications"] / numeric["submissions"]),
        }
        if fields["workload"] in PAYLOAD_RATE_WORKLOADS:
            sample["payload_bytes_per_second"] = (
                operations_per_second * numeric["request_bytes"])
        samples.append(sample)
    return samples


def summarize(samples):
    operation_rates = [sample["operations_per_second"] for sample in samples]
    total_requests = sum(sample["iterations"] for sample in samples)
    total_duration_ns = sum(sample["duration_ns"] for sample in samples)
    total_submissions = sum(sample["submissions"] for sample in samples)
    total_notifications = sum(sample["notifications"] for sample in samples)
    combined_rate = total_requests * 1_000_000_000 / total_duration_ns
    summary = {
        "total_requests": total_requests,
        "total_duration_ns": total_duration_ns,
        "operations_per_second": combined_rate,
        "operations_per_second_min": min(operation_rates),
        "operations_per_second_max": max(operation_rates),
        "mean_service_time_ns": total_duration_ns / total_requests,
        "notifications_per_submission": (
            total_notifications / total_submissions),
    }
    if "payload_bytes_per_second" in samples[0]:
        summary["payload_bytes_per_second"] = (
            combined_rate * samples[0]["request_bytes"])
    return summary


def get_version(path):
    try:
        result = subprocess.run(
            [path, "--version"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    text = result.stdout.strip()
    if text:
        return text.splitlines()[0]
    if result.returncode != 0:
        return None
    text = result.stderr.strip()
    return text.splitlines()[0] if text else None


def get_processor_model():
    try:
        with open("/proc/cpuinfo", encoding="utf-8") as cpuinfo:
            for line in cpuinfo:
                name, separator, value = line.partition(":")
                if separator and name.strip() in {"model name", "Hardware"}:
                    return value.strip()
    except OSError:
        pass
    return platform.processor() or None


def build_guest():
    result = subprocess.run(
        ["make", "perf-initramfs"], cwd=ROOT,
        capture_output=True, text=True)
    if result.returncode:
        sys.stderr.write(result.stdout)
        sys.stderr.write(result.stderr)
    return result.returncode


def run_vmm(cmd, spawn, rounds):
    try:
        result = subprocess.run(cmd, **spawn)
        raw_output = result.stdout + result.stderr
    except subprocess.TimeoutExpired as error:
        raw_output = (error.stdout or b"") + (error.stderr or b"")
    output = raw_output.decode(errors="replace")
    samples = parse_results(output)
    if len(samples) != rounds:
        error = re.search(r"VVPERF error=(\w+)", output)
        detail = error.group(1) if error else "missing guest results"
        raise RuntimeError(f"Performance run failed with {detail}\n{output}")
    return samples


def run_guest(args, runner):
    backend = runner.detect_vmm(args.vmm)
    if args.device not in BACKEND_DEVICES.get(backend.name, set()):
        raise RuntimeError(
            f"{backend.name} does not provide virtio-{args.device}")
    kernel = args.kernel or runner.fetch_kernel()
    initramfs = os.path.join(ROOT, "target", "perf-initramfs.cpio.gz")
    with tempfile.TemporaryDirectory(prefix="vvperf.") as temp_dir:
        disk = os.path.join(temp_dir, "disk.raw")
        with open(disk, "wb") as disk_file:
            disk_file.truncate(args.disk_size * 1024 * 1024)
        cmdline = (
            f"console={backend.console_device} "
            f"initcall_blacklist={DEVICE_INITCALL[args.device]} "
            f"vv.perf_device={args.device} "
            f"vv.perf_iterations={args.iterations} vv.perf_rounds={args.rounds} "
            f"vv.perf_warmup={args.warmup} "
            f"vv.perf_queue_depth={args.queue_depth} "
            f"vv.perf_batch_size={args.batch_size} "
            f"vv.perf_experiment={args.experiment_class} "
            f"vv.perf_changed={args.changed_dimension}")
        opts = {
            "blk_queues": 1, "cpus": args.cpus, "direct": args.direct,
            "exit_on_guest_end": True, "fuzz_device": args.device,
            "io_engine": args.io_engine, "memory": args.memory,
            "net_queues": 2, "packed": False,
        }
        cmd = backend.build_cmd(kernel, initramfs, disk, cmdline, opts)
        spawn = {"capture_output": True, "timeout": args.timeout}
        master_fd = None
        slave_fd = None
        if backend.name == "openvmm":
            master_fd, slave_fd = pty.openpty()
            spawn["stdin"] = slave_fd
            spawn["preexec_fn"] = runner._ctty_preexec(
                os.ttyname(slave_fd).encode())
        else:
            spawn["stdin"] = subprocess.DEVNULL
        vsock_listener = None
        if args.device == "vsock" and backend.name == "qemu":
            vsock_listener = VsockListener(5678)
            vsock_listener.start()
        elif args.device == "vsock" and backend.name == "ch":
            vsock_path = disk.rsplit(".", 1)[0] + ".vsock_5678"
            vsock_listener = VsockListener(5678, path=vsock_path)
            vsock_listener.start()
        try:
            samples = run_vmm(cmd, spawn, args.rounds)
        finally:
            if vsock_listener is not None:
                vsock_listener.stop()
            if master_fd is not None:
                os.close(master_fd)
            if slave_fd is not None:
                os.close(slave_fd)
    return backend, samples, kernel


def make_report(args, backend, samples, kernel):
    sample = samples[0]
    vmm = {"backend": backend.name, "path": os.path.abspath(args.vmm),
           "version": get_version(args.vmm),
           "process_mode": ("single" if backend.name == "openvmm"
                            else "default")}
    if backend.name == "qemu":
        vmm["machine"] = ("virt" if platform.machine() == "aarch64"
                          else "default")
        vmm["accelerator"] = "kvm"
    if sample["workload"] == "blk":
        direct = args.direct or (
            backend.name == "openvmm" and args.io_engine == "aio")
        resource = {"type": "file", "format": "raw",
                    "direct": direct,
                    "disk_size_mib": args.disk_size,
                    "io_engine": args.io_engine}
    elif sample["workload"] == "net":
        endpoints = {"qemu": "user", "ch": "tap", "openvmm": "consomme"}
        resource = {"type": "network",
                    "endpoint": endpoints[backend.name]}
    elif sample["workload"] == "rng":
        source = ("default" if backend.name == "openvmm" else "/dev/urandom")
        resource = {"type": "rng", "source": source}
    else:
        endpoints = {"qemu": "vhost", "ch": "unix"}
        resource = {"type": "vsock", "endpoint": endpoints[backend.name]}
    return {
        "schema_version": 3,
        "experiment": {
            "class": sample["experiment_class"],
            "changed_dimension": sample["changed_dimension"],
        },
        "host": {"machine": platform.machine(), "system": platform.system(),
                 "kernel": platform.release(),
                 "processor": get_processor_model()},
        "guest": {"kernel": os.path.abspath(kernel)},
        "vmm": vmm,
        "execution": {"cpus": args.cpus, "memory": args.memory,
                      "iterations": args.iterations, "rounds": args.rounds,
                      "warmup": args.warmup},
        "queue": {"transport": "pci", "format": sample["queue_format"],
                  "depth": sample["queue_depth"],
                  "batch_size": sample["batch_size"],
                  "negotiated_features": sample["negotiated_features"]},
        "workload": {"device": sample["workload"],
                     "operation": sample["operation"],
                     "request_bytes": sample["request_bytes"]},
        "backend": resource,
        "instrumentation": {"enabled": False},
        "timing": {"mode": sample["timing_mode"],
                   "clock_source": sample["clock_source"]},
        "samples": samples,
        "summary": summarize(samples),
    }


def compatibility_mismatches(baseline, candidate):
    """Return fields that prevent a valid report comparison."""
    ignored = {"samples", "summary"}
    fixed_vmm = {"accelerator", "backend", "machine", "process_mode"}
    mismatches = []
    experiment = baseline.get("experiment", {})
    if candidate.get("experiment") != experiment:
        return ["experiment"]
    experiment_class = experiment.get("class")
    if experiment_class not in {"queue", "frontend", "backend"}:
        raise RuntimeError("Performance report has invalid experiment class")
    changed = experiment.get("changed_dimension")
    allowed = None
    if changed:
        section_names = {"queue": "queue", "frontend": "workload",
                         "backend": "backend"}
        section_name = section_names[experiment_class]
        if (changed not in baseline.get(section_name, {}) or
                changed not in candidate.get(section_name, {})):
            raise RuntimeError(
                "Performance report has invalid changed dimension")
        if experiment_class == "queue":
            allowed = f"queue.{changed}"
        elif experiment_class == "frontend":
            allowed = f"workload.{changed}"
        else:
            allowed = f"backend.{changed}"

    def compare(path, left, right):
        if path in ignored or path == allowed:
            return
        if path == "vmm":
            for name in fixed_vmm:
                if left.get(name) != right.get(name):
                    mismatches.append(f"vmm.{name}")
            return
        if isinstance(left, dict) and isinstance(right, dict):
            for name in sorted(left.keys() | right.keys()):
                compare(f"{path}.{name}" if path else name,
                        left.get(name), right.get(name))
        elif left != right:
            mismatches.append(path)

    compare("", baseline, candidate)
    return mismatches


def compare_reports(baseline, candidate):
    for report in (baseline, candidate):
        if report.get("schema_version") != 3:
            raise RuntimeError("Unsupported performance report schema")
        for section in ("experiment", "vmm", "workload", "summary"):
            if not isinstance(report.get(section), dict):
                raise RuntimeError(
                    f"Performance report lacks {section} section")
    mismatches = compatibility_mismatches(baseline, candidate)
    if mismatches:
        raise RuntimeError(
            "Incompatible performance reports: " + ", ".join(mismatches))
    try:
        baseline_summary = baseline["summary"]
        candidate_summary = candidate["summary"]
        baseline_rate = baseline_summary["operations_per_second"]
        candidate_rate = candidate_summary["operations_per_second"]
        baseline_range = [
            baseline_summary["operations_per_second_min"],
            baseline_summary["operations_per_second_max"],
        ]
        candidate_range = [
            candidate_summary["operations_per_second_min"],
            candidate_summary["operations_per_second_max"],
        ]
    except (KeyError, TypeError) as error:
        raise RuntimeError("Performance report lacks throughput summary") from error
    numeric_values = [baseline_rate, candidate_rate, *baseline_range,
                      *candidate_range]
    if (not all(isinstance(value, (int, float)) for value in numeric_values) or
            not all(math.isfinite(value) for value in numeric_values)):
        raise RuntimeError("Performance report throughput summary is invalid")
    if baseline_rate <= 0 or candidate_rate <= 0:
        raise RuntimeError("Performance report operation rate must be positive")
    for rate, round_range in ((baseline_rate, baseline_range),
                              (candidate_rate, candidate_range)):
        if (round_range[0] <= 0 or round_range[0] > round_range[1] or
                not round_range[0] <= rate <= round_range[1]):
            raise RuntimeError("Performance report round range is invalid")
    ranges_overlap = (
        baseline_range[0] <= candidate_range[1] and
        candidate_range[0] <= baseline_range[1])
    return {
        "comparison_version": 1,
        "metric": "operations_per_second",
        "baseline": {
            "value": baseline_rate,
            "round_range": baseline_range,
            "relative_spread_percent": (
                (baseline_range[1] - baseline_range[0]) / baseline_rate * 100),
            "vmm": baseline["vmm"],
        },
        "candidate": {
            "value": candidate_rate,
            "round_range": candidate_range,
            "relative_spread_percent": (
                (candidate_range[1] - candidate_range[0]) / candidate_rate * 100),
            "vmm": candidate["vmm"],
        },
        "change_percent": (candidate_rate / baseline_rate - 1) * 100,
        "round_ranges_overlap": ranges_overlap,
        "experiment": baseline["experiment"],
        "workload": baseline["workload"],
    }


def load_report(path):
    try:
        with open(path, encoding="utf-8") as report_file:
            report = json.load(report_file)
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Cannot read performance report {path}: {error}") from error
    if not isinstance(report, dict):
        raise RuntimeError(f"Performance report {path} must contain an object")
    return report


def format_comparison(comparison):
    baseline = comparison["baseline"]
    candidate = comparison["candidate"]
    overlap = "yes" if comparison["round_ranges_overlap"] else "no"
    return "\n".join([
        "virtio performance comparison",
        "",
        f"Baseline VMM: {baseline['vmm']['path']}",
        f"Candidate VMM: {candidate['vmm']['path']}",
        f"Baseline:     {baseline['value']:.2f} operations/s",
        f"Candidate:    {candidate['value']:.2f} operations/s",
        f"Change:       {comparison['change_percent']:+.2f}%",
        (f"Baseline range:  {baseline['round_range'][0]:.2f} to "
         f"{baseline['round_range'][1]:.2f} operations/s"),
        f"Baseline spread: {baseline['relative_spread_percent']:.2f}%",
        (f"Candidate range: {candidate['round_range'][0]:.2f} to "
         f"{candidate['round_range'][1]:.2f} operations/s"),
        f"Candidate spread: {candidate['relative_spread_percent']:.2f}%",
        f"Ranges overlap:  {overlap}",
    ])


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description="Measure virtio request throughput")
    parser.add_argument("-m", "--vmm", metavar="PATH")
    parser.add_argument("--compare", nargs=2,
                        metavar=("BASELINE", "CANDIDATE"))
    parser.add_argument("--device", choices=tuple(DEVICE_INITCALL), default="blk")
    parser.add_argument("-k", "--kernel", metavar="PATH")
    parser.add_argument("-n", "--iterations", type=int, default=10000)
    parser.add_argument("--rounds", type=int, default=5)
    parser.add_argument("--warmup", type=int, default=1000)
    parser.add_argument("--queue-depth", type=int, choices=(1, 2, 4, 8, 16),
                        default=1)
    parser.add_argument("--batch-size", type=int, choices=(1, 4, 8, 16),
                        default=1)
    parser.add_argument("--timing-mode", choices=("throughput",),
                        default="throughput")
    parser.add_argument("--cpus", type=int, default=1)
    parser.add_argument("--memory", default="256M")
    parser.add_argument("--disk-size", type=int, default=64, metavar="MIB")
    parser.add_argument("--timeout", type=int, default=60)
    parser.add_argument("--io-engine", choices=("default", "io_uring", "aio", "sync"),
                        default="default")
    parser.add_argument("--direct", action="store_true")
    parser.add_argument("--experiment-class",
                        choices=("queue", "frontend", "backend"),
                        default="queue")
    parser.add_argument("--changed-dimension", default="none", metavar="NAME")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--format", choices=("human", "json"), default="human")
    parser.add_argument("-o", "--output", metavar="PATH")
    args = parser.parse_args(argv)
    if args.compare and args.vmm:
        parser.error("--compare cannot be used with --vmm")
    if not args.compare and not args.vmm:
        parser.error("--vmm is required unless --compare is used")
    for name in ("iterations", "rounds", "warmup", "cpus", "disk_size", "timeout"):
        if getattr(args, name) < 1:
            parser.error(f"--{name.replace('_', '-')} must be positive")
    if args.batch_size > args.queue_depth:
        parser.error("--batch-size must not exceed --queue-depth")
    return args


def format_human(report, verbose=False):
    workload = report["workload"]
    samples = report["samples"]
    summary = report["summary"]
    sample = samples[0]
    operation_rate = summary["operations_per_second"]
    round_rates = [item["operations_per_second"] for item in samples]
    request_size = sample["request_bytes"]
    if request_size >= 1024 and request_size % 1024 == 0:
        request_size_text = f"{request_size // 1024} KiB"
    else:
        request_size_text = f"{request_size} bytes"
    lines = [
        f"virtio {DEVICE_LABEL[workload['device']]} throughput",
        "",
        f"Request size:  {request_size_text}",
        f"Queue depth:   {report['queue']['depth']}",
        f"Batch size:    {report['queue']['batch_size']}",
        f"Requests:      {summary['total_requests']}",
        f"Operation rate: {operation_rate:.2f} operations/s",
        (f"Round range:    {min(round_rates):.2f} to "
         f"{max(round_rates):.2f} operations/s"),
        (f"Mean service:  {summary['mean_service_time_ns'] / 1000:.2f} "
         "us per operation"),
        (f"Notify ratio:  {summary['notifications_per_submission']:.4f} "
         "per submission"),
    ]
    if "payload_bytes_per_second" in summary:
        lines.append(
            f"Payload rate: {summary['payload_bytes_per_second'] / (1024 * 1024):.2f} MiB/s")
    if verbose:
        lines += [
            "",
            f"VMM:           {report['vmm']['backend']}",
            f"Binary:        {report['vmm']['path']}",
            f"Warmup:        {report['execution']['warmup']} requests",
            f"Rounds:        {len(samples)}",
        ]
        if report["vmm"]["version"]:
            lines.append(f"Version:       {report['vmm']['version']}")
        lines += [
            "",
            "Round  Requests  Elapsed s  Operations/s",
        ]
        for item in samples:
            lines.append(
                f"{item['round']:>5}  {item['iterations']:>8}  "
                f"{item['duration_ns'] / 1_000_000_000:>9.3f}  "
                f"{item['operations_per_second']:>12.2f}")
    return "\n".join(lines)


def main(argv=None):
    args = parse_args(argv)
    if args.compare:
        try:
            baseline = load_report(args.compare[0])
            candidate = load_report(args.compare[1])
            comparison = compare_reports(baseline, candidate)
        except RuntimeError as error:
            sys.exit(str(error))
        encoded = json.dumps(comparison, indent=2) + "\n"
        if args.output:
            with open(args.output, "w", encoding="utf-8") as output_file:
                output_file.write(encoded)
        if args.format == "json":
            print(encoded, end="")
        else:
            print(format_comparison(comparison))
        return 0
    build_result = build_guest()
    if build_result:
        return build_result
    runner = load_runner()
    try:
        backend, samples, kernel = run_guest(args, runner)
    except RuntimeError as error:
        sys.exit(str(error))
    report = make_report(args, backend, samples, kernel)
    encoded = json.dumps(report, indent=2) + "\n"
    if args.output:
        with open(args.output, "w", encoding="utf-8") as output_file:
            output_file.write(encoded)
    if args.format == "json":
        print(encoded, end="")
    else:
        print(format_human(report, args.verbose))
    return 0


if __name__ == "__main__":
    sys.exit(main())
