def cmd_decode(args):
    """Decode and print the contents of a fuzz blob."""
    for path in args.blobs:
        blob = open(path, "rb").read()
        qs, nd, ai, ac = struct.unpack_from("<HHHH", blob)
        print(f"{path}:")
        print(f"  queue_size={qs} num_descs={nd} avail_idx={ai} avail_count={ac}")
        off = 8
        for i in range(nd):
            if off + 8 > len(blob):
                print(f"  desc[{i}]: <truncated>")
                break
            l, f, n = struct.unpack_from("<IHH", blob, off)
            print(f"  desc[{i}]: len={l} flags=0x{f:04x} next={n}")
            off += 8
        avail_off = off
        for i in range(ac):
            if avail_off + 2 > len(blob):
                break
            v, = struct.unpack_from("<H", blob, avail_off)
            print(f"  avail[{i}]: {v}")
            avail_off += 2
        payload_off = avail_off
        payload_len = len(blob) - payload_off
        nonzero = sum(1 for b in blob[payload_off:] if b != 0)
        print(f"  payload: {payload_len} bytes ({nonzero} non-zero)")
        # Annotations
        notes = _annotate_blob(blob)
        if notes:
            for note in notes:
                print(f"  ⚠ {note}")
        print()


