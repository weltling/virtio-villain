    "net":      ("N",   "VIRTIO_PCI_DEVICE_NET"),
    "console":  ("C",   "VIRTIO_PCI_DEVICE_CONSOLE"),
    "rng":      ("RNG", "VIRTIO_PCI_DEVICE_RNG"),
    "balloon":  ("L",   "VIRTIO_PCI_DEVICE_BALLOON"),
    "vsock":    ("V",   "VIRTIO_PCI_DEVICE_VSOCK"),
    "iommu":    ("I",   "VIRTIO_PCI_DEVICE_IOMMU"),
    "mem":      ("R",   "VIRTIO_PCI_DEVICE_MEM"),
