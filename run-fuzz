def cmd_fuzz(args):
    """Main fuzzing loop."""
    os.makedirs(args.corpus_dir, exist_ok=True)
    os.makedirs(args.crashes_dir, exist_ok=True)

    # Build the fuzz binary
    print("[*] Building fuzz guest...")
    result = subprocess.run(["make", "fuzz"], capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(f"Build failed: {result.stderr}")

    fuzz_binary = os.path.join(_SCRIPT_DIR, "target", "fuzz")
    section_offset = find_fuzz_section_offset(fuzz_binary)
    if section_offset is None:
        sys.exit("Cannot find .fuzz_input section in fuzz binary")

    print(f"[*] .fuzz_input section at offset 0x{section_offset:x}")

    # Check for coverage tools; fall back to dumb fuzzing if missing
    if not args.no_coverage:
        if not shutil.which("llvm-profdata") or not shutil.which("llvm-cov"):
            print("[!] llvm-profdata/llvm-cov not found; "
                  "disabling coverage feedback")
            args.no_coverage = True

    # Load or seed corpus
    corpus = []
    for f in os.listdir(args.corpus_dir):
        path = os.path.join(args.corpus_dir, f)
        with open(path, "rb") as fh:
            corpus.append(fh.read())
    if not corpus:
        seed = make_seed()
        corpus.append(seed)
        with open(os.path.join(args.corpus_dir, "seed_000.bin"), "wb") as fh:
            fh.write(seed)
        print("[*] Seeded corpus with 1 entry")
    else:
        print(f"[*] Loaded {len(corpus)} corpus entries")

    # Wire up corpus for splice mutation
    global _corpus_ref
    _corpus_ref = corpus

    # Fetch kernel once
    kernel = args.kernel or _fetch_kernel()

    jobs = args.jobs
    baseline_edges = set()
    stats = {"iterations": 0, "crashes": 0, "new_edges": 0,
             "corpus_size": len(corpus)}
    lock = threading.Lock()

    # Set up per-worker state
    worker_dirs = []
    for w in range(jobs):
        wdir = tempfile.mkdtemp(prefix=f"vvfuzz_w{w}_")
        wb = os.path.join(wdir, "fuzz")
        shutil.copy2(fuzz_binary, wb)
        initramfs = os.path.join(wdir, "initramfs.cpio.gz")
        disk = os.path.join(wdir, "disk.raw")
        with open(disk, "wb") as f:
            f.seek(64 * 1024 * 1024 - 1)
            f.write(b"\x00")
        worker_dirs.append({
            "dir": wdir,
            "binary": wb,
            "initramfs": initramfs,
            "disk": disk,
        })

    print(f"[*] Starting fuzzing: {args.iterations} iterations, "
          f"jobs={jobs}, timeout={args.timeout}s, "
          f"cpus={args.cpus}, memory={args.memory}")
    print(f"[*] VMM={args.vmm}")
    print(f"[*] Corpus: {args.corpus_dir}/, Crashes: {args.crashes_dir}/")
    print()

    start_time = time.time()
    stop = threading.Event()

    def _worker(iteration, worker_id):
        """Run one fuzz iteration. Returns (crashed, blob, vmm_output, edges)."""
        if stop.is_set():
            return None
        w = worker_dirs[worker_id % jobs]

        with lock:
            parent = random.choice(corpus)
        blob = mutate(parent)

        # Patch into this worker's binary
        patch_blob(w["binary"], blob, section_offset)

        # Rebuild initramfs
        build_initramfs(w["binary"], w["initramfs"])

        # Clear old profraw
        for fname in os.listdir(w["dir"]):
            if fname.endswith(".profraw"):
                os.unlink(os.path.join(w["dir"], fname))

        # Run VMM
        exit_code, crashed, vmm_output = run_vmm(
            args.vmm, w["initramfs"], w["dir"], args.timeout,
            kernel_path=kernel, disk_path=w["disk"],
            cpus=args.cpus, memory=args.memory
        )

        # Collect coverage
        edges = set()
        if not args.no_coverage:
            profdata_path = os.path.join(w["dir"], "merged.profdata")
            edges = collect_coverage(args.vmm, profdata_path, w["dir"])

        return iteration, crashed, blob, vmm_output, edges

    try:
        if jobs == 1:
            # Sequential path (simpler, no threading overhead)
            for i in range(args.iterations):
                if stop.is_set():
                    break
                result = _worker(i, 0)
                if result is None:
                    break
                _, crashed, blob, vmm_output, edges = result
                stats["iterations"] += 1

                if crashed:
                    stats["crashes"] += 1
                    blob_hash = hashlib.sha256(blob).hexdigest()[:16]
                    crash_path = os.path.join(
                        args.crashes_dir, f"crash_{blob_hash}.bin")
                    if not os.path.exists(crash_path):
                        with open(crash_path, "wb") as fh:
                            fh.write(blob)
                        print(f"\n[!] CRASH #{stats['crashes']} "
                              f"saved: {crash_path}")
                        _print_crash_detail(blob, vmm_output, crash_path)

                if not args.no_coverage and edges:
                    new_edges = edges - baseline_edges
                    if new_edges:
                        stats["new_edges"] += len(new_edges)
                        baseline_edges |= new_edges
                        corpus.append(blob)
                        stats["corpus_size"] = len(corpus)
                        blob_hash = hashlib.sha256(blob).hexdigest()[:16]
                        corpus_path = os.path.join(
                            args.corpus_dir,
                            f"gen_{i:06d}_{blob_hash}.bin")
                        with open(corpus_path, "wb") as fh:
                            fh.write(blob)

                if (i + 1) % 10 == 0:
                    elapsed = time.time() - start_time
                    rate = stats["iterations"] / elapsed if elapsed > 0 else 0
                    print(f"[{i+1}/{args.iterations}] "
                          f"{rate:.1f} exec/s | "
                          f"corpus={stats['corpus_size']} | "
                          f"crashes={stats['crashes']} | "
                          f"edges={len(baseline_edges)}",
                          end="\r")
        else:
            # Parallel path: each worker owns a dedicated slot
            import queue
            slot_queue = queue.Queue()
            for s in range(jobs):
                slot_queue.put(s)

            def _parallel_worker(iteration):
                if stop.is_set():
                    return None
                slot = slot_queue.get()
                try:
                    return _worker(iteration, slot)
                finally:
                    slot_queue.put(slot)

            with ThreadPoolExecutor(max_workers=jobs) as pool:
                futures = {}
                for i in range(args.iterations):
                    if stop.is_set():
                        break
                    f = pool.submit(_parallel_worker, i)
                    futures[f] = i

                for future in as_completed(futures):
                    result = future.result()
                    if result is None:
                        continue
                    iteration, crashed, blob, vmm_output, edges = result

                    with lock:
                        stats["iterations"] += 1

                        if crashed:
                            stats["crashes"] += 1
                            blob_hash = hashlib.sha256(blob).hexdigest()[:16]
                            crash_path = os.path.join(
                                args.crashes_dir,
                                f"crash_{blob_hash}.bin")
                            if not os.path.exists(crash_path):
                                with open(crash_path, "wb") as fh:
                                    fh.write(blob)
                                print(f"\n[!] CRASH #{stats['crashes']} "
                                      f"saved: {crash_path}")
                                _print_crash_detail(
                                    blob, vmm_output, crash_path)

                        if not args.no_coverage and edges:
                            new_edges = edges - baseline_edges
                            if new_edges:
                                stats["new_edges"] += len(new_edges)
                                baseline_edges |= new_edges
                                corpus.append(blob)
                                stats["corpus_size"] = len(corpus)
                                blob_hash = \
                                    hashlib.sha256(blob).hexdigest()[:16]
                                corpus_path = os.path.join(
                                    args.corpus_dir,
                                    f"gen_{iteration:06d}_{blob_hash}.bin")
                                with open(corpus_path, "wb") as fh:
                                    fh.write(blob)

                        done = stats["iterations"]
                        if done % 10 == 0:
                            elapsed = time.time() - start_time
                            rate = done / elapsed if elapsed > 0 else 0
                            print(
                                f"[{done}/{args.iterations}] "
                                f"{rate:.1f} exec/s | "
                                f"corpus={stats['corpus_size']} | "
                                f"crashes={stats['crashes']} | "
                                f"edges={len(baseline_edges)}",
                                end="\r")

    except KeyboardInterrupt:
        stop.set()
        print("\n[*] Interrupted")

    elapsed = time.time() - start_time
    print(f"\n\n[*] Done: {stats['iterations']} iterations in {elapsed:.1f}s "
          f"({stats['iterations']/elapsed:.1f} exec/s)")
    print(f"    Corpus: {stats['corpus_size']} entries")
    print(f"    Crashes: {stats['crashes']}")
    print(f"    New edges: {stats['new_edges']}")

    # Cleanup
    for w in worker_dirs:
        shutil.rmtree(w["dir"], ignore_errors=True)


def main():
    print_banner(sys.stderr)
    parser = argparse.ArgumentParser(
        description="virtio-villain coverage fuzzer",
        usage="%(prog)s <command> [options]",
    )
    sub = parser.add_subparsers(dest="command")

    # Shared flag for subcommands that boot the VMM. Applied via the run
    # module so the registry and revert logic live in exactly one place.
    sysconf_parent = argparse.ArgumentParser(add_help=False)
    sysconf_parent.add_argument(
        "--apply-sysconfig", action="store_true",
        help="Apply host settings a sanitizer instrumented VMM needs, "
             "then revert them on exit. Grants the VMM CAP_SYS_PTRACE "
             "so LeakSanitizer can complete its exit time leak scan "
             "against the non dumpable VMM, and sets "
             "kernel.yama.ptrace_scope=0 as a fallback. Uses sudo; only "
             "the values it changed are reverted.")

    # --- fuzz (default) ---
    p_fuzz = sub.add_parser("fuzz", help="Run the fuzzing loop",
                            parents=[sysconf_parent])
    p_fuzz.add_argument("--vmm", required=True, help="Path to VMM binary")
    p_fuzz.add_argument("--kernel", default=None,
                        help="Path to guest kernel (auto-detected if omitted)")
    p_fuzz.add_argument("--disk", default=None,
                        help="Path to raw disk image (created in tmpdir if omitted)")
    p_fuzz.add_argument("--iterations", "-n", type=int, default=10000,
                        help="Number of fuzzing iterations")
    p_fuzz.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                        help="Directory for interesting inputs")
    p_fuzz.add_argument("--crashes-dir", default=os.path.join("target", "crashes"),
                        help="Directory for crash-triggering inputs")
    p_fuzz.add_argument("--timeout", type=int, default=3,
                        help="VMM boot timeout in seconds")
    p_fuzz.add_argument("--jobs", "-j", type=int, default=1,
                        help="Number of parallel VMs (default: 1)")
    p_fuzz.add_argument("--cpus", type=int, default=1,
                        help="vCPUs per VM (default: 1)")
    p_fuzz.add_argument("--memory", default="128M",
                        type=_run_mod._normalize_mem,
                        help="RAM per VM (default: 128M)")
    p_fuzz.add_argument("--no-coverage", action="store_true",
                        help="Skip coverage feedback (dumb fuzzing)")

    # --- decode ---
    p_decode = sub.add_parser("decode", help="Decode and print crash blobs")
    p_decode.add_argument("blobs", nargs="+", help="Blob files to decode")

    # --- gen-test ---
    p_gen = sub.add_parser("gen-test",
                           help="Generate a C test from a fuzz blob")
    p_gen.add_argument("blob", help="Fuzz blob to convert")
    p_gen.add_argument("--device", default=None,
                       choices=sorted(_DEVICE_MAP),
                       help="Override target virtio device. "
                            "Resolved from bin/fuzz.c if omitted")
    p_gen.add_argument("--id", default=None,
                       help="Test ID, e.g. B9000 or RNG9000. "
                            "Auto-picked from the fuzz range if omitted")
    p_gen.add_argument("--force", action="store_true",
                       help="Overwrite existing test file")

    # --- replay ---
    p_replay = sub.add_parser("replay", help="Replay crash blobs against VMM",
                              parents=[sysconf_parent])
    p_replay.add_argument("--vmm", required=True, help="Path to VMM binary")
    p_replay.add_argument("--kernel", default=None,
                          help="Path to guest kernel (auto-detected if omitted)")
    p_replay.add_argument("--disk", default=None,
                          help="Path to raw disk image (created in tmpdir if omitted)")
    p_replay.add_argument("--timeout", type=int, default=5,
                          help="VMM boot timeout in seconds")
    p_replay.add_argument("-v", "--verbose", action="store_true",
                          help="Print the full captured VMM stderr log")
    p_replay.add_argument("blobs", nargs="+", help="Blob files to replay")

    # --- seed ---
    p_seed = sub.add_parser("seed", help="Generate corpus from existing tests")
    p_seed.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                        help="Directory to write seeds into")

    # --- triage ---
    p_triage = sub.add_parser("triage", help="Replay and group crashes by error class",
                              parents=[sysconf_parent])
    p_triage.add_argument("--vmm", required=True, help="Path to VMM binary")
    p_triage.add_argument("--kernel", default=None,
                          help="Path to guest kernel (auto-detected if omitted)")
    p_triage.add_argument("--disk", default=None,
                          help="Path to raw disk image (created in tmpdir if omitted)")
    p_triage.add_argument("--timeout", type=int, default=5,
                          help="VMM boot timeout in seconds")
    p_triage.add_argument("--crashes-dir", default=os.path.join("target", "crashes"),
                          help="Directory containing crash blobs")

    # --- minimize ---
    p_min = sub.add_parser("minimize", help="Remove corpus entries with redundant coverage",
                           parents=[sysconf_parent])
    p_min.add_argument("--vmm", required=True, help="Path to VMM binary")
    p_min.add_argument("--kernel", default=None,
                       help="Path to guest kernel (auto-detected if omitted)")
    p_min.add_argument("--timeout", type=int, default=3,
                       help="VMM boot timeout in seconds")
    p_min.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                       help="Directory containing corpus blobs")
    p_min.add_argument("--dry-run", action="store_true",
                       help="Show what would be removed without deleting")

    # --- cov-report ---
    p_cov = sub.add_parser("cov-report", help="Generate HTML coverage report from corpus",
                           parents=[sysconf_parent])
    p_cov.add_argument("--vmm", required=True, help="Path to VMM binary")
    p_cov.add_argument("--kernel", default=None,
                       help="Path to guest kernel (auto-detected if omitted)")
    p_cov.add_argument("--timeout", type=int, default=3,
                       help="VMM boot timeout in seconds")
    p_cov.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                       help="Directory containing corpus blobs")
    p_cov.add_argument("--output", "-o", default=os.path.join("target", "cov-report"),
                       help="Output directory for HTML report")
    p_cov.add_argument("--no-profraw", action="store_true",
                       help="Skip merging target/profraw/ from test runs")

    args = parser.parse_args()

    if getattr(args, "apply_sysconfig", False):
        _run_mod.enable_sysconfigs(getattr(args, "vmm", None))

    if args.command == "decode":
        cmd_decode(args)
    elif args.command == "gen-test":
        cmd_gen_test(args)
    elif args.command == "replay":
        cmd_replay(args)
    elif args.command == "seed":
        cmd_seed(args)
    elif args.command == "triage":
        cmd_triage(args)
    elif args.command == "minimize":
        cmd_minimize(args)
    elif args.command == "cov-report":
        cmd_cov_report(args)
    elif args.command == "fuzz":
        cmd_fuzz(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
