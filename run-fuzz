# --- Blob Format ---

BLOB_SIZE = 4096
INPUT_SIZE = 64 * 1024
FUZZ_BLOB_MAGIC = b"VVFZ"
FUZZ_BLOB_VERSION = 1
FUZZ_BLOB_HEADER_FMT = "<4sHH"
FUZZ_BLOB_HEADER_SIZE = struct.calcsize(FUZZ_BLOB_HEADER_FMT)
FUZZ_SEGMENT_HEADER_FMT = "<HHI"
FUZZ_SEGMENT_HEADER_SIZE = struct.calcsize(FUZZ_SEGMENT_HEADER_FMT)
VIRTIO_PCI_DEVICE_NET = 0x1041
VIRTIO_PCI_DEVICE_BLK = 0x1042
HEADER_FMT = "<HHHH"  # queue_size, num_descs, avail_idx, avail_count
HEADER_SIZE = struct.calcsize(HEADER_FMT)
DESC_FMT = "<HHI"  # next, flags, len  -- wait, actual struct is: u32 len, u16 flags, u16 next
DESC_FMT = "<IHH"  # len: u32, flags: u16, next: u16
DESC_SIZE = struct.calcsize(DESC_FMT)


def make_blob(queue_size, descs, avail_idx, avail_ring, payload):
    """Create a fuzz blob from components."""
    num_descs = len(descs)
    avail_count = len(avail_ring)

    hdr = struct.pack(HEADER_FMT, queue_size, num_descs, avail_idx, avail_count)
    desc_data = b"".join(struct.pack(DESC_FMT, d[0], d[1], d[2]) for d in descs)
    avail_data = struct.pack(f"<{avail_count}H", *avail_ring)
    blob = hdr + desc_data + avail_data + payload

    # Pad or truncate to BLOB_SIZE
    if len(blob) > BLOB_SIZE:
        blob = blob[:BLOB_SIZE]
    else:
        blob = blob + b"\x00" * (BLOB_SIZE - len(blob))
    return blob


def make_seed():
    """Create a minimal seed blob: single read of sector 0."""
    # blk header: type=0 (IN), ioprio=0, sector=0 → 16 bytes
    # data: 512 bytes writable
    # status: 1 byte writable
    payload = struct.pack("<IIQ", 0, 0, 0)  # header (16 bytes)
    payload += b"\x00" * 512  # data buffer
    payload += b"\xff"  # status byte

    descs = [
        # (len, flags, next)
        (16, 0x01, 1),    # header: NEXT, readable
        (512, 0x03, 2),   # data: NEXT | WRITE
        (1, 0x02, 0),     # status: WRITE
    ]
    avail_ring = [0]  # head at desc 0

    return make_blk_blob(make_blob(16, descs, 1, avail_ring, payload))


class FuzzSegment:
    """A queue blob and the virtio device queue it targets."""

    def __init__(self, device_id, queue_index, vq):
        self.device_id = device_id
        self.queue_index = queue_index
        self.vq = vq


class FuzzBlob:
    """Versioned outer framing for one or more virtqueue segments."""

    def __init__(self, segments):
        self.segments = segments

    @classmethod
    def parse(cls, blob):
        blob = bytes(blob)
        if not blob.startswith(FUZZ_BLOB_MAGIC):
            raise ValueError("missing fuzz blob magic")
        if len(blob) < FUZZ_BLOB_HEADER_SIZE:
            raise ValueError("truncated fuzz blob header")
        _magic, version, count = struct.unpack_from(FUZZ_BLOB_HEADER_FMT,
                                                    blob, 0)
        if version != FUZZ_BLOB_VERSION:
            raise ValueError(f"unsupported fuzz blob version {version}")
        offset = FUZZ_BLOB_HEADER_SIZE
        segments = []
        for _ in range(count):
            if offset + FUZZ_SEGMENT_HEADER_SIZE > len(blob):
                raise ValueError("truncated fuzz segment header")
            device_id, queue_index, length = struct.unpack_from(
                FUZZ_SEGMENT_HEADER_FMT, blob, offset)
            offset += FUZZ_SEGMENT_HEADER_SIZE
            if length > len(blob) - offset:
                raise ValueError("truncated fuzz segment")
            segments.append(FuzzSegment(device_id, queue_index,
                                        VqBlob.parse(blob[offset:offset + length])))
            offset += length
        if not segments:
            raise ValueError("fuzz blob has no segments")
        return cls(segments)

    def serialize(self):
        if not self.segments:
            raise ValueError("fuzz blob has no segments")
        data = bytearray(struct.pack(FUZZ_BLOB_HEADER_FMT, FUZZ_BLOB_MAGIC,
                                     FUZZ_BLOB_VERSION, len(self.segments)))
        for segment in self.segments:
            vq_blob = segment.vq.serialize()
            data.extend(struct.pack(FUZZ_SEGMENT_HEADER_FMT,
                                    segment.device_id & 0xffff,
                                    segment.queue_index & 0xffff,
                                    len(vq_blob)))
            data.extend(vq_blob)
        if len(data) > INPUT_SIZE:
            raise ValueError("fuzz blob exceeds input section")
        data.extend(b"\x00" * (INPUT_SIZE - len(data)))
        return bytes(data)


def make_blk_blob(vring, queue_index=0):
    """Wrap a single virtqueue blob as a blk segment on a request queue."""
    return FuzzBlob(
        [FuzzSegment(VIRTIO_PCI_DEVICE_BLK, queue_index, VqBlob.parse(vring))]
    ).serialize()


# virtio_blk request types (lib/virtio_spec.h)
VIRTIO_BLK_T_IN = 0
VIRTIO_BLK_T_OUT = 1
VIRTIO_BLK_T_FLUSH = 4
VIRTIO_BLK_T_GET_ID = 8
VIRTIO_BLK_T_GET_LIFETIME = 10
VIRTIO_BLK_T_DISCARD = 11
VIRTIO_BLK_T_WRITE_ZEROES = 13

# Data buffer sizes the device fills or reads for each shaped request.
VIRTIO_BLK_ID_BYTES = 20        # GET_ID string length
_BLK_LIFETIME_LEN = 12          # virtio_blk_lifetime struct
_BLK_DISCARD_SEG_LEN = 16       # virtio_blk_discard_write_zeroes struct
_BLK_DESC_F_NEXT = 0x01
_BLK_DESC_F_WRITE = 0x02


def _blk_request_blob(req_type, sector, data, data_writable, queue_index=0):
    """Build a valid blk request: header, optional data, status byte.

    data is the middle descriptor bytes, or None for a header plus status
    request like FLUSH. data_writable marks the data buffer as device
    filled rather than guest supplied. queue_index selects the request
    queue the segment targets.
    """
    payload = bytearray(struct.pack("<IIQ", req_type, 0, sector))
    if data is None:
        descs = [[16, _BLK_DESC_F_NEXT, 1], [1, _BLK_DESC_F_WRITE, 0]]
        payload += b"\xff"
    else:
        data_flags = _BLK_DESC_F_NEXT
        if data_writable:
            data_flags |= _BLK_DESC_F_WRITE
        descs = [
            [16, _BLK_DESC_F_NEXT, 1],
            [len(data), data_flags, 2],
            [1, _BLK_DESC_F_WRITE, 0],
        ]
        payload += bytes(data)
        payload += b"\xff"
    return make_blk_blob(make_blob(16, descs, 1, [0], bytes(payload)),
                         queue_index)


def blk_request_seeds():
    """One valid blob per blk request type, keyed by a short name.

    Every type seeds request queue 0, and read and write seed the second
    request queue so the higher queue steering path runs.
    """
    discard_seg = struct.pack("<QII", 0, 1, 0)  # sector, num_sectors, flags
    seeds = {
        "in": _blk_request_blob(VIRTIO_BLK_T_IN, 0, b"\x00" * 512, True),
        "out": _blk_request_blob(VIRTIO_BLK_T_OUT, 0, b"\x00" * 512, False),
        "flush": _blk_request_blob(VIRTIO_BLK_T_FLUSH, 0, None, False),
        "get_id": _blk_request_blob(VIRTIO_BLK_T_GET_ID, 0,
                                    b"\x00" * VIRTIO_BLK_ID_BYTES, True),
        "get_lifetime": _blk_request_blob(VIRTIO_BLK_T_GET_LIFETIME, 0,
                                          b"\x00" * _BLK_LIFETIME_LEN, True),
        "discard": _blk_request_blob(VIRTIO_BLK_T_DISCARD, 0,
                                     discard_seg, False),
        "write_zeroes": _blk_request_blob(VIRTIO_BLK_T_WRITE_ZEROES, 0,
                                          discard_seg, False),
        "in_q1": _blk_request_blob(VIRTIO_BLK_T_IN, 0, b"\x00" * 512, True,
                                   queue_index=1),
        "out_q1": _blk_request_blob(VIRTIO_BLK_T_OUT, 0, b"\x00" * 512, False,
                                    queue_index=1),
    }
    return seeds


# virtio-net control queue (lib/virtio_spec.h). With the fuzz net device
# booted at num_queues=2 the queues are rx=0, tx=1, and the control queue
# at index 2 once VIRTIO_NET_F_CTRL_VQ is negotiated by the guest.
VIRTIO_NET_F_CTRL_VQ = 17
VIRTIO_NET_CTRL_MQ = 4
VIRTIO_NET_CTRL_MQ_VQ_PAIRS_SET = 0
_NET_CTRL_QUEUE = 2


def _net_ctrl_blob(cls, command, data):
    """Build a net control request on the control queue: hdr, data, ack.

    data is the command payload bytes, or None for a header plus ack
    request with no command data.
    """
    payload = bytearray(struct.pack("<BB", cls & 0xff, command & 0xff))
    if data is None:
        descs = [[2, _BLK_DESC_F_NEXT, 1], [1, _BLK_DESC_F_WRITE, 0]]
    else:
        descs = [
            [2, _BLK_DESC_F_NEXT, 1],
            [len(data), _BLK_DESC_F_NEXT, 2],
            [1, _BLK_DESC_F_WRITE, 0],
        ]
        payload += bytes(data)
    payload += b"\xff"  # ack byte the device writes
    vring = make_blob(16, descs, 1, [0], bytes(payload))
    return FuzzBlob([FuzzSegment(VIRTIO_PCI_DEVICE_NET, _NET_CTRL_QUEUE,
                                 VqBlob.parse(vring))]).serialize()


def net_ctrl_seeds():
    """Valid and malformed net control queue requests, keyed by name."""
    return {
        "mq_pairs_set": _net_ctrl_blob(VIRTIO_NET_CTRL_MQ,
                                       VIRTIO_NET_CTRL_MQ_VQ_PAIRS_SET,
                                       struct.pack("<H", 1)),
        "bad_class": _net_ctrl_blob(0xff, 0x00, b"\x00\x00"),
        "bad_command": _net_ctrl_blob(VIRTIO_NET_CTRL_MQ, 0xff, b"\x00\x00"),
        "mq_no_data": _net_ctrl_blob(VIRTIO_NET_CTRL_MQ,
                                     VIRTIO_NET_CTRL_MQ_VQ_PAIRS_SET, None),
    }


# virtio-mem guest request type (lib/virtio_spec.h).
VIRTIO_MEM_REQ_STATE = 3


def _device_seg_blob(device, queue_index, descs, payload):
    """Wrap descriptors and payload as one segment for a device queue."""
    device_id = _DEVICE_MAP[device][2]
    vring = make_blob(16, descs, 1, [0], bytes(payload))
    return FuzzBlob([FuzzSegment(device_id, queue_index,
                                 VqBlob.parse(vring))]).serialize()


def device_seeds():
    """One minimal valid seed per device, keyed by (device, name).

    Each seed targets the primary data queue of a device with buffers
    of the right direction and size so a focused run has a foothold in
    that device instead of starting from noise.
    """
    n = _BLK_DESC_F_NEXT
    w = _BLK_DESC_F_WRITE
    net_tx = struct.pack("<BBHHHH", 0, 0, 0, 0, 0, 0) + b"\x00" * 64
    mem_req = struct.pack("<HHHHQHHHH", VIRTIO_MEM_REQ_STATE, 0, 0, 0,
                          0, 1, 0, 0, 0)
    return {
        # rng: one writable buffer the device fills with random bytes
        ("rng", "fill"): _device_seg_blob("rng", 0, [[16, w, 0]],
                                          b"\x00" * 16),
        # console: a readable transmit buffer on the tx queue
        ("console", "tx"): _device_seg_blob("console", 1, [[8, 0, 0]],
                                            b"vv-fuzz\n"),
        # net: readable frame with a 10 byte header on the tx queue
        ("net", "tx"): _device_seg_blob("net", 1, [[10, n, 1], [64, 0, 0]],
                                        net_tx),
        # net: a writable receive buffer on the rx queue
        ("net", "rx"): _device_seg_blob("net", 0, [[74, w, 0]],
                                        b"\x00" * 74),
        # vsock: a readable packet header on the tx queue
        ("vsock", "tx"): _device_seg_blob("vsock", 1, [[44, 0, 0]],
                                          b"\x00" * 44),
        # balloon: a readable page frame number on the inflate queue
        ("balloon", "inflate"): _device_seg_blob("balloon", 0, [[4, 0, 0]],
                                                 b"\x00" * 4),
        # mem: a readable request and a writable response on the guest queue
        ("mem", "state"): _device_seg_blob("mem", 0, [[24, n, 1], [10, w, 0]],
                                           mem_req + b"\x00" * 10),
    }


# --- Mutation Engine ---

def mutate(blob):
    """Mutate one segment of a versioned blob, returning a versioned blob."""
    fb = FuzzBlob.parse(blob)
    segment = random.choice(fb.segments)
    data = bytearray(segment.vq.serialize())
    strategy = random.choice([
        _bit_flip,
        _byte_arith,
        _interesting_16,
        _desc_flags,
        _avail_corrupt,
        _payload_noise,
        _chain_shuffle,
        _splice_corpus,
        _grow_desc,
        _shrink_desc,
        _header_corrupt,
        _avail_ring_replay,
        _desc_addr_mutate,
        _queue_size_mutate,
        _endian_swap,
        _zero_fill_region,
        _duplicate_desc,
        _indirect_inject,
        _structural_mutate,
        _multi_strategy,
    ])
    segment.vq = VqBlob.parse(bytes(strategy(data)))
    return fb.serialize()


def _bit_flip(data):
    for _ in range(random.randint(1, 4)):
        pos = random.randint(0, len(data) - 1)
        bit = random.randint(0, 7)
        data[pos] ^= (1 << bit)
    return data


def _byte_arith(data):
    pos = random.randint(0, len(data) - 1)
    delta = random.randint(-35, 35)
    data[pos] = (data[pos] + delta) & 0xFF
    return data


INTERESTING_16 = [0, 1, 0x7F, 0x80, 0xFF, 0x100, 0x7FFF, 0x8000, 0xFFFF]


def _interesting_16(data):
    if len(data) < 2:
        return data
    pos = random.randint(0, len(data) - 2)
    val = random.choice(INTERESTING_16)
    struct.pack_into("<H", data, pos, val)
    return data


def _desc_flags(data):
    """Randomize the flags field of a random descriptor."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs == 0:
        return data
    idx = random.randint(0, num_descs - 1)
    offset = HEADER_SIZE + idx * DESC_SIZE + 4  # flags is at +4 in desc
    if offset + 2 <= len(data):
        val = random.randint(0, 0xFFFF)
        struct.pack_into("<H", data, offset, val)
    return data


def _avail_corrupt(data):
    """Corrupt avail_idx or an avail ring entry."""
    # Overwrite avail_idx (bytes 4-5 in header)
    val = random.randint(0, 0xFFFF)
    struct.pack_into("<H", data, 4, val)
    return data


def _payload_noise(data):
    """Write random bytes into the payload region."""
    start = random.randint(HEADER_SIZE, len(data) - 1)
    length = random.randint(1, min(32, len(data) - start))
    for i in range(length):
        data[start + i] = random.randint(0, 255)
    return data


def _chain_shuffle(data):
    """Swap next pointers between two random descriptors."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs < 2:
        return data
    a, b = random.sample(range(num_descs), 2)
    off_a = HEADER_SIZE + a * DESC_SIZE + 6  # next is at +6 in desc (len:4 + flags:2)
    off_b = HEADER_SIZE + b * DESC_SIZE + 6
    if off_a + 2 <= len(data) and off_b + 2 <= len(data):
        va = struct.unpack_from("<H", data, off_a)[0]
        vb = struct.unpack_from("<H", data, off_b)[0]
        struct.pack_into("<H", data, off_a, vb)
        struct.pack_into("<H", data, off_b, va)
    return data


# Module-level corpus reference for splice mutation
_corpus_ref = []


def _splice_corpus(data):
    """Crossover with another corpus segment at a random boundary."""
    if not _corpus_ref:
        return _bit_flip(data)
    try:
        other_fb = FuzzBlob.parse(random.choice(_corpus_ref))
    except ValueError:
        return _bit_flip(data)
    other = bytearray(random.choice(other_fb.segments).vq.serialize())
    if len(other) != len(data):
        other = (other + bytearray(len(data)))[:len(data)]
    # Pick a crossover point
    point = random.randint(1, len(data) - 1)
    data[point:] = other[point:]
    return data


def _grow_desc(data):
    """Add a descriptor by incrementing num_descs."""
    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, data, 0)
    # Don't grow beyond what fits
    max_descs = (BLOB_SIZE - HEADER_SIZE - ac * 2) // DESC_SIZE
    if nd >= max_descs or nd >= 128:
        return data
    # Increment num_descs
    nd += 1
    struct.pack_into(HEADER_FMT, data, 0, qs, nd, ai, ac)
    # Write a random descriptor at the new slot
    off = HEADER_SIZE + (nd - 1) * DESC_SIZE
    if off + DESC_SIZE <= len(data):
        length = random.choice([1, 16, 512, 4096])
        flags = random.choice([0x00, 0x01, 0x02, 0x03])
        next_idx = random.randint(0, nd - 1)
        struct.pack_into(DESC_FMT, data, off, length, flags, next_idx)
    return data


def _shrink_desc(data):
    """Remove the last descriptor by decrementing num_descs."""
    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, data, 0)
    if nd <= 1:
        return data
    nd -= 1
    struct.pack_into(HEADER_FMT, data, 0, qs, nd, ai, ac)
    return data


def _header_corrupt(data):
    """Corrupt the virtio_blk_req header fields (type, ioprio, sector).

    Targets the first 16 bytes of the payload region which corresponds
    to the device-level request header that gets mapped from descriptor 0.
    """
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    # Payload starts after header + descs + avail entries
    payload_off = HEADER_SIZE + num_descs * DESC_SIZE + hdr[3] * 2
    if payload_off + 16 > len(data):
        return _bit_flip(data)
    field = random.choice(["type", "ioprio", "sector"])
    if field == "type":
        val = random.choice([0, 1, 4, 5, 8, 11, 13, 0xFF, 0x7FFFFFFF, 0x80000000])
        struct.pack_into("<I", data, payload_off, val)
    elif field == "ioprio":
        struct.pack_into("<I", data, payload_off + 4, random.randint(0, 0xFFFFFFFF))
    else:
        struct.pack_into("<Q", data, payload_off + 8, random.choice([
            0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0xFFFFFFFFFFFFFFFF,
        ]))
    return data


def _avail_ring_replay(data):
    """Duplicate an avail ring entry, causing the same head to be processed twice."""
    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, data, 0)
    if ac < 1 or nd < 1:
        return data
    avail_start = HEADER_SIZE + nd * DESC_SIZE
    if avail_start + ac * 2 > len(data):
        return data
    # Read the first entry and duplicate it into a second slot
    first_entry = struct.unpack_from("<H", data, avail_start)[0]
    if ac < 2:
        # Grow avail_count to make room
        ac = 2
        struct.pack_into(HEADER_FMT, data, 0, qs, nd, ai, ac)
    slot = random.randint(1, ac - 1)
    off = avail_start + slot * 2
    if off + 2 <= len(data):
        struct.pack_into("<H", data, off, first_entry)
    return data


INTERESTING_ADDRS = [0, 1, 0xFFF, 0x1000, 0xDEAD000, 0x7FFFFFFF, 0xFFFFFFFF]


def _desc_addr_mutate(data):
    """Replace a descriptor's implied address with an interesting value.

    Since the blob format doesn't carry full 64-bit addrs (the guest binary
    builds them), we corrupt the len field to trigger boundary conditions
    in addr+len overflow checks.
    """
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs == 0:
        return data
    idx = random.randint(0, num_descs - 1)
    off = HEADER_SIZE + idx * DESC_SIZE
    if off + 4 <= len(data):
        val = random.choice(INTERESTING_ADDRS)
        struct.pack_into("<I", data, off, val)
    return data


def _queue_size_mutate(data):
    """Alter queue_size to invalid values."""
    vals = [0, 1, 3, 7, 15, 127, 255, 256, 512, 1024, 32768, 65535]
    struct.pack_into("<H", data, 0, random.choice(vals))
    return data


def _endian_swap(data):
    """Swap byte order of a random 16 or 32-bit field."""
    if len(data) < 4:
        return data
    width = random.choice([2, 4])
    pos = random.randint(0, len(data) - width)
    chunk = data[pos:pos + width]
    data[pos:pos + width] = chunk[::-1]
    return data


def _zero_fill_region(data):
    """Zero out a random contiguous region."""
    start = random.randint(0, len(data) - 1)
    length = random.randint(1, min(64, len(data) - start))
    data[start:start + length] = b'\x00' * length
    return data


def _duplicate_desc(data):
    """Copy one descriptor over another (aliased buffer)."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs < 2:
        return data
    src, dst = random.sample(range(num_descs), 2)
    src_off = HEADER_SIZE + src * DESC_SIZE
    dst_off = HEADER_SIZE + dst * DESC_SIZE
    if src_off + DESC_SIZE <= len(data) and dst_off + DESC_SIZE <= len(data):
        data[dst_off:dst_off + DESC_SIZE] = data[src_off:src_off + DESC_SIZE]
    return data


def _indirect_inject(data):
    """Turn a normal descriptor into an indirect one by setting INDIRECT flag."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs == 0:
        return data
    idx = random.randint(0, num_descs - 1)
    flags_off = HEADER_SIZE + idx * DESC_SIZE + 4  # flags at +4
    if flags_off + 2 <= len(data):
        flags = struct.unpack_from("<H", data, flags_off)[0]
        flags |= 0x04  # VIRTQ_DESC_F_INDIRECT
        struct.pack_into("<H", data, flags_off, flags)
    return data


def _multi_strategy(data):
    """Apply 2-3 mutations in sequence for deeper exploration."""
    strategies = [
        _bit_flip, _byte_arith, _interesting_16, _desc_flags,
        _avail_corrupt, _payload_noise, _chain_shuffle,
        _desc_addr_mutate, _queue_size_mutate, _zero_fill_region,
    ]
    count = random.randint(2, 3)
    for _ in range(count):
        data = bytearray(random.choice(strategies)(data))
    return data


# --- Structure-aware mutation ---
#
# The byte-level strategies above edit a flat bytearray with fixed offset
# math. Changing num_descs or avail_count in the header does not move the
# descriptor, avail, and payload regions, so the layout silently desyncs.
# VqBlob parses a blob into a virtqueue object, lets operators mutate at
# the structural level (descriptors, chains, avail ring, header), then
# serializes back with a consistent byte layout. Semantic adversariality
# (out of range heads, chain loops, oversized lengths, num_descs greater
# than queue_size) is preserved; only the on-disk framing stays coherent
# so the guest parser reads exactly what the operator intended.

# Mirror the C harness clamps in lib/fuzz_input.h.
MAX_DESCS = 128       # FUZZ_MAX_DESCS
MAX_AVAIL = 256       # FUZZ_MAX_QUEUE_SIZE

# Structural operators only grow the rings, which would ratchet a blob to
# the hard maximum over successive mutations. A saturated blob makes the
# VMM process hundreds of request heads of long chains per run, wedging
# and hitting the timeout far more often. Keep structural blobs light: a
# handful of descriptors and heads still expresses chains, loops, and
# indirect tables, and num_descs above the default queue_size of 16.
SOFT_DESCS = 16
SOFT_AVAIL = 16

_F_NEXT = 0x01
_F_WRITE = 0x02
_F_INDIRECT = 0x04

# Virtio dictionary: lengths and flag combinations worth steering toward.
STRUCT_LENS = [0, 1, 15, 16, 17, 512, 4095, 4096,
               0xFFFF, 0x10000, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF]
STRUCT_FLAGS = [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
                0x0F, 0x8000, 0xFFFF]


class VqBlob:
    """Structured view of a fuzz blob: header, descriptors, avail, payload."""

    def __init__(self, queue_size, avail_idx, descs, avail_ring, payload):
        self.queue_size = queue_size
        self.avail_idx = avail_idx
        self.descs = descs            # list of [len, flags, next]
        self.avail_ring = avail_ring  # list of int (head indices)
        self.payload = bytes(payload)

    @classmethod
    def parse(cls, blob):
        """Tolerant parse mirroring the C side: clamp counts, stop at EOF."""
        blob = bytes(blob)
        if len(blob) < HEADER_SIZE:
            blob = blob + b"\x00" * (HEADER_SIZE - len(blob))
        qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, blob, 0)
        nd = min(nd, MAX_DESCS)
        ac = min(ac, MAX_AVAIL)

        off = HEADER_SIZE
        descs = []
        for _ in range(nd):
            if off + DESC_SIZE > len(blob):
                break
            descs.append(list(struct.unpack_from(DESC_FMT, blob, off)))
            off += DESC_SIZE

        avail_ring = []
        for _ in range(ac):
            if off + 2 > len(blob):
                break
            avail_ring.append(struct.unpack_from("<H", blob, off)[0])
            off += 2

        return cls(qs, ai, descs, avail_ring, blob[off:])

    def serialize(self):
        """Re-emit a BLOB_SIZE blob, trimming so every region fits."""
        descs = [
            (d[0] & 0xFFFFFFFF, d[1] & 0xFFFF, d[2] & 0xFFFF)
            for d in self.descs[:MAX_DESCS]
        ]
        avail = [v & 0xFFFF for v in self.avail_ring[:MAX_AVAIL]]

        def _fits():
            return (HEADER_SIZE + len(descs) * DESC_SIZE
                    + len(avail) * 2) <= BLOB_SIZE

        while not _fits() and avail:
            avail.pop()
        while not _fits() and descs:
            descs.pop()

        cap = BLOB_SIZE - HEADER_SIZE - len(descs) * DESC_SIZE - len(avail) * 2
        payload = self.payload[:max(0, cap)]
        return make_blob(self.queue_size & 0xFFFF, descs,
                         self.avail_idx & 0xFFFF, avail, payload)


def _op_set_len(vq):
    """Set a descriptor length to a boundary value."""
    if not vq.descs:
        return
    vq.descs[random.randrange(len(vq.descs))][0] = random.choice(STRUCT_LENS)


def _op_set_flags(vq):
    """Replace a descriptor's flags with an interesting combination."""
    if not vq.descs:
        return
    vq.descs[random.randrange(len(vq.descs))][1] = random.choice(STRUCT_FLAGS)


def _op_make_chain(vq):
    """Link every descriptor into a single NEXT chain 0->1->...->n-1."""
    n = len(vq.descs)
    if n < 2:
        return
    for i in range(n - 1):
        vq.descs[i][1] |= _F_NEXT
        vq.descs[i][2] = i + 1
    vq.descs[n - 1][1] &= ~_F_NEXT


def _op_make_loop(vq):
    """Point a descriptor's NEXT back to itself or an earlier slot."""
    n = len(vq.descs)
    if n == 0:
        return
    i = random.randrange(n)
    vq.descs[i][1] |= _F_NEXT
    vq.descs[i][2] = random.randint(0, n - 1)


def _op_make_indirect(vq):
    """Mark a descriptor INDIRECT (clearing NEXT) with a table-like length."""
    if not vq.descs:
        return
    i = random.randrange(len(vq.descs))
    vq.descs[i][1] = (vq.descs[i][1] | _F_INDIRECT) & ~_F_NEXT
    vq.descs[i][0] = random.choice([0, 16, 17, 32, 256, 4096])


def _op_insert_desc(vq):
    """Insert a fresh descriptor at a random position."""
    if len(vq.descs) >= SOFT_DESCS:
        return
    length = random.choice(STRUCT_LENS)
    flags = random.choice(STRUCT_FLAGS)
    nxt = random.randint(0, len(vq.descs)) if vq.descs else 0
    vq.descs.insert(random.randint(0, len(vq.descs)), [length, flags, nxt])


def _op_clone_desc(vq):
    """Duplicate a descriptor, aliasing its buffer."""
    if not vq.descs or len(vq.descs) >= SOFT_DESCS:
        return
    i = random.randrange(len(vq.descs))
    vq.descs.insert(i, list(vq.descs[i]))


def _op_remove_desc(vq):
    """Drop a descriptor, keeping at least one."""
    if len(vq.descs) <= 1:
        return
    vq.descs.pop(random.randrange(len(vq.descs)))


def _op_avail_point(vq):
    """Aim an avail ring entry at a boundary head index."""
    if not vq.avail_ring:
        vq.avail_ring = [0]
    n = max(1, len(vq.descs))
    vq.avail_ring[random.randrange(len(vq.avail_ring))] = random.choice(
        [0, n - 1, n, n + 1, 0xFFFF])


def _op_dup_avail(vq):
    """Replay a head by duplicating an avail ring entry."""
    if not vq.avail_ring or len(vq.avail_ring) >= SOFT_AVAIL:
        return
    vq.avail_ring.append(vq.avail_ring[random.randrange(len(vq.avail_ring))])


def _op_remove_avail(vq):
    """Drop an avail ring entry, keeping at least one."""
    if len(vq.avail_ring) <= 1:
        return
    vq.avail_ring.pop(random.randrange(len(vq.avail_ring)))


def _op_avail_idx(vq):
    """Set avail_idx to a boundary value."""
    vq.avail_idx = random.choice(
        [0, 1, len(vq.avail_ring), vq.queue_size,
         (vq.queue_size + 1) & 0xFFFF, 0xFFFF])


def _op_queue_size(vq):
    """Set queue_size to an invalid or boundary value."""
    vq.queue_size = random.choice(
        [0, 1, 3, 7, 15, 127, 256, 512, 1024, 32768, 65535])


# The fuzz worker disk is 64 MiB, so valid sectors are 0.._BLK_DISK_SECTORS-1.
_BLK_DISK_SECTORS = (64 * 1024 * 1024) // 512
_BLK_VALID_TYPES = [
    VIRTIO_BLK_T_IN, VIRTIO_BLK_T_OUT, VIRTIO_BLK_T_FLUSH,
    VIRTIO_BLK_T_GET_ID, VIRTIO_BLK_T_GET_LIFETIME,
    VIRTIO_BLK_T_DISCARD, VIRTIO_BLK_T_WRITE_ZEROES,
]


def _op_blk_valid_header(vq):
    """Shape the outhdr with a valid blk type and an in-range sector."""
    if len(vq.payload) < 16:
        return
    payload = bytearray(vq.payload)
    struct.pack_into("<IIQ", payload, 0, random.choice(_BLK_VALID_TYPES), 0,
                     random.randint(0, _BLK_DISK_SECTORS - 1))
    vq.payload = bytes(payload)


def _op_blk_oob_sector(vq):
    """Shape the outhdr with a valid type but an out-of-range sector."""
    if len(vq.payload) < 16:
        return
    sector = random.choice([
        _BLK_DISK_SECTORS,
        _BLK_DISK_SECTORS + random.randint(1, 1 << 20),
        0xFFFFFFFFFFFFFFFF,
    ])
    payload = bytearray(vq.payload)
    struct.pack_into("<IIQ", payload, 0, random.choice(_BLK_VALID_TYPES), 0,
                     sector)
    vq.payload = bytes(payload)


_STRUCT_OPS = [
    _op_set_len, _op_set_flags, _op_make_chain, _op_make_loop,
    _op_make_indirect, _op_insert_desc, _op_clone_desc, _op_remove_desc,
    _op_avail_point, _op_dup_avail, _op_remove_avail, _op_avail_idx,
    _op_queue_size, _op_blk_valid_header, _op_blk_oob_sector,
]


def _structural_mutate(data):
    """Parse into a VqBlob, apply structural operators, serialize back."""
    vq = VqBlob.parse(bytes(data))
    for _ in range(random.randint(1, 3)):
        random.choice(_STRUCT_OPS)(vq)
    # Cap ring sizes so a parent that arrived saturated does not keep its
    # weight; structural exploration needs variety, not maximum length.
    del vq.descs[SOFT_DESCS:]
    del vq.avail_ring[SOFT_AVAIL:]
    return bytearray(vq.serialize())


# --- Coverage ---

# rustup ships llvm-profdata and llvm-cov via the llvm-tools component but
# installs them in the toolchain private rustlib bin and does not shim
# them onto PATH. Resolve them there so coverage guided fuzzing works on a
# stock rustup setup instead of silently downgrading to dumb fuzzing.
@functools.lru_cache(maxsize=None)
def _rustlib_bin():
    try:
        sysroot = subprocess.check_output(
            ["rustc", "--print", "sysroot"], text=True).strip()
        host = next(
            line.split("host: ", 1)[1].strip()
            for line in subprocess.check_output(
                ["rustc", "-vV"], text=True).splitlines()
            if line.startswith("host: "))
        return os.path.join(sysroot, "lib", "rustlib", host, "bin")
    except Exception:
        return None


@functools.lru_cache(maxsize=None)
def find_llvm_tool(name):
    """Resolve an llvm tool absolute path.

    Honors an env override (LLVM_PROFDATA / LLVM_COV), then PATH, then
    rustup private rustlib bin. Returns None when not found.
    """
    override = os.environ.get(name.upper().replace("-", "_"))
    if override and os.access(override, os.X_OK):
        return override
    found = shutil.which(name)
    if found:
        return found
    rustlib = _rustlib_bin()
    if rustlib:
        candidate = os.path.join(rustlib, name)
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def _require_llvm_tools(context, vmm=None):
    """Return (profdata, cov) absolute paths or exit with a hint.

    When vmm is given, prefer tools that can actually read that binary's
    profraw (matching the toolchain it was built with) instead of the
    default toolchain, which may emit an incompatible raw profile version.
    """
    profdata = cov = None
    if vmm is not None:
        profdata, cov = select_coverage_tools(vmm)
    if not profdata or not cov:
        profdata = find_llvm_tool("llvm-profdata")
        cov = find_llvm_tool("llvm-cov")
    if not profdata or not cov:
        where = _rustlib_bin() or "<rustc sysroot>/lib/rustlib/<host>/bin"
        sys.exit(
            f"llvm-profdata and llvm-cov are required for {context}.\n"
            "Install them with: rustup component add llvm-tools-preview\n"
            f"They live in {where} (not on PATH by default). The fuzzer "
            "looks there automatically, or set LLVM_PROFDATA / LLVM_COV.")
    return profdata, cov


# Coverage tools chosen by select_coverage_tools() to match the VMM's raw
# profile version; consulted by collect_coverage() before the generic lookup.
_SELECTED_PROFDATA = None
_SELECTED_COV = None


def _iter_toolchain_bins():
    """Yield rustlib bin dirs for every installed rustup toolchain."""
    seen = set()
    default = _rustlib_bin()
    if default:
        seen.add(default)
        yield default
    try:
        listing = subprocess.check_output(
            ["rustup", "toolchain", "list"], text=True).splitlines()
    except Exception:
        return
    for raw in listing:
        tc = raw.split(" ", 1)[0].strip()
        if not tc:
            continue
        try:
            sysroot = subprocess.check_output(
                ["rustc", f"+{tc}", "--print", "sysroot"], text=True,
                stderr=subprocess.DEVNULL).strip()
            host = next(
                line.split("host: ", 1)[1].strip()
                for line in subprocess.check_output(
                    ["rustc", f"+{tc}", "-vV"], text=True,
                    stderr=subprocess.DEVNULL).splitlines()
                if line.startswith("host: "))
        except Exception:
            continue
        cand = os.path.join(sysroot, "lib", "rustlib", host, "bin")
        if cand not in seen:
            seen.add(cand)
            yield cand


def _profraw_probe(vmm):
    """Emit a probe profraw via a clean, fast VMM exit (--version)."""
    fd, path = tempfile.mkstemp(suffix=".profraw", prefix="vvfuzz_probe_")
    os.close(fd)
    env = os.environ.copy()
    env["LLVM_PROFILE_FILE"] = path
    try:
        subprocess.run([vmm, "--version"], env=env,
                       capture_output=True, timeout=30)
    except Exception:
        return None
    if os.path.exists(path) and os.path.getsize(path) > 0:
        return path
    return None


def _vmm_has_coverage_instrumentation(vmm_path):
    """Best effort check that the VMM was built with coverage.

    Returns True if the binary exposes __llvm_profile symbols, False if
    nm ran and saw symbols but none matched, or None when it cannot be
    told (nm missing, unreadable, or a stripped binary with no symbols).
    """
    nm = shutil.which("nm")
    if not nm:
        return None
    try:
        proc = subprocess.Popen([nm, vmm_path], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return None
    found = False
    saw_symbol = False
    try:
        for line in proc.stdout:
            saw_symbol = True
            if "__llvm_profile" in line:
                found = True
                break
    finally:
        proc.stdout.close()
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
    if found:
        return True
    return False if saw_symbol else None


def select_coverage_tools(vmm):
    """Pick llvm-profdata/llvm-cov that can actually read the VMM's profraw.

    The raw profile format version is tied to the toolchain that built the
    VMM, so tools from a different toolchain (stable vs nightly) silently fail
    to merge and yield zero edges. Probe with a real profraw and choose a
    matching pair. Returns (profdata, cov) or (None, None).
    """
    global _SELECTED_PROFDATA, _SELECTED_COV

    candidates = []
    env_pd = os.environ.get("LLVM_PROFDATA")
    env_cov = os.environ.get("LLVM_COV")
    if (env_pd and env_cov and os.access(env_pd, os.X_OK)
            and os.access(env_cov, os.X_OK)):
        candidates.append((env_pd, env_cov))
    path_pd = shutil.which("llvm-profdata")
    path_cov = shutil.which("llvm-cov")
    if path_pd and path_cov:
        candidates.append((path_pd, path_cov))
    for bindir in _iter_toolchain_bins():
        pd = os.path.join(bindir, "llvm-profdata")
        cov = os.path.join(bindir, "llvm-cov")
        if os.access(pd, os.X_OK) and os.access(cov, os.X_OK):
            candidates.append((pd, cov))

    if not candidates:
        return None, None

    probe = _profraw_probe(vmm)
    if probe is None:
        # Cannot validate; fall back to the first available pair.
        _SELECTED_PROFDATA, _SELECTED_COV = candidates[0]
        return candidates[0]

    try:
        for pd, cov in candidates:
            fd, out = tempfile.mkstemp(suffix=".profdata")
            os.close(fd)
            result = subprocess.run(
                [pd, "merge", "-sparse", probe, "-o", out],
                capture_output=True)
            os.path.exists(out) and os.unlink(out)
            if result.returncode == 0:
                _SELECTED_PROFDATA, _SELECTED_COV = pd, cov
                return pd, cov
    finally:
        os.unlink(probe)
    return None, None


_PROFDATA_FUNC_RE = re.compile(r"^  (.+):\s*$")


def _parse_profdata_counts(text):
    """Turn llvm-profdata show --counts output into a covered set.

    Reads the merged profile alone, so it never loads the coverage map
    out of the VMM binary. Each function contributes an entry marker when
    its function count is nonzero and one marker per nonzero block
    counter, which gives a cheap edge like signal for the fuzzing loop.
    """
    edges = set()
    func = None
    fhash = ""
    for line in text.splitlines():
        m = _PROFDATA_FUNC_RE.match(line)
        if m:
            func = m.group(1)
            fhash = ""
            continue
        s = line.strip()
        if s.startswith("Hash:"):
            fhash = s.split(None, 1)[1].strip()
        elif s.startswith("Function count:"):
            try:
                if int(s.split(":", 1)[1]) > 0:
                    edges.add((func, fhash, -1))
            except ValueError:
                pass
        elif s.startswith("Block counts:"):
            inside = s[s.find("[") + 1:s.rfind("]")]
            for i, tok in enumerate(inside.split(",")):
                tok = tok.strip()
                if tok and tok != "0":
                    edges.add((func, fhash, i))
    return edges


def collect_coverage(vmm_binary, profdata_path, profraw_dir):
    """Merge profraw and derive a covered set from the profile counters.

    The signal comes from llvm-profdata alone, not llvm-cov, so it does
    not reload the large coverage map out of the VMM binary every
    iteration. vmm_binary is unused but kept for call compatibility.
    """
    profraw_files = [
        os.path.join(profraw_dir, f)
        for f in os.listdir(profraw_dir)
        if f.endswith(".profraw")
    ]
    if not profraw_files:
        return set()

    profdata_tool = _SELECTED_PROFDATA or find_llvm_tool("llvm-profdata")
    if not profdata_tool:
        return set()

    merge_cmd = [
        profdata_tool, "merge", "-sparse",
        *profraw_files, "-o", profdata_path
    ]
    result = subprocess.run(merge_cmd, capture_output=True)
    if result.returncode != 0:
        return set()

    show_cmd = [
        profdata_tool, "show", "--all-functions", "--counts", profdata_path
    ]
    result = subprocess.run(show_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        return set()
    return _parse_profdata_counts(result.stdout)


