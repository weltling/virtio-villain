# --- Blob Format ---

BLOB_SIZE = 4096
HEADER_FMT = "<HHHH"  # queue_size, num_descs, avail_idx, avail_count
HEADER_SIZE = struct.calcsize(HEADER_FMT)
DESC_FMT = "<HHI"  # next, flags, len  -- wait, actual struct is: u32 len, u16 flags, u16 next
DESC_FMT = "<IHH"  # len: u32, flags: u16, next: u16
DESC_SIZE = struct.calcsize(DESC_FMT)


def make_blob(queue_size, descs, avail_idx, avail_ring, payload):
    """Create a fuzz blob from components."""
    num_descs = len(descs)
    avail_count = len(avail_ring)

    hdr = struct.pack(HEADER_FMT, queue_size, num_descs, avail_idx, avail_count)
    desc_data = b"".join(struct.pack(DESC_FMT, d[0], d[1], d[2]) for d in descs)
    avail_data = struct.pack(f"<{avail_count}H", *avail_ring)
    blob = hdr + desc_data + avail_data + payload

    # Pad or truncate to BLOB_SIZE
    if len(blob) > BLOB_SIZE:
        blob = blob[:BLOB_SIZE]
    else:
        blob = blob + b"\x00" * (BLOB_SIZE - len(blob))
    return blob


def make_seed():
    """Create a minimal seed blob: single read of sector 0."""
    # blk header: type=0 (IN), ioprio=0, sector=0 → 16 bytes
    # data: 512 bytes writable
    # status: 1 byte writable
    payload = struct.pack("<IIQ", 0, 0, 0)  # header (16 bytes)
    payload += b"\x00" * 512  # data buffer
    payload += b"\xff"  # status byte

    descs = [
        # (len, flags, next)
        (16, 0x01, 1),    # header: NEXT, readable
        (512, 0x03, 2),   # data: NEXT | WRITE
        (1, 0x02, 0),     # status: WRITE
    ]
    avail_ring = [0]  # head at desc 0

    return make_blob(16, descs, 1, avail_ring, payload)


# --- Mutation Engine ---

def mutate(blob):
    """Apply a random mutation to a blob."""
    data = bytearray(blob)
    strategy = random.choice([
        _bit_flip,
        _byte_arith,
        _interesting_16,
        _desc_flags,
        _avail_corrupt,
        _payload_noise,
        _chain_shuffle,
        _splice_corpus,
        _grow_desc,
        _shrink_desc,
        _header_corrupt,
        _avail_ring_replay,
        _desc_addr_mutate,
        _queue_size_mutate,
        _endian_swap,
        _zero_fill_region,
        _duplicate_desc,
        _indirect_inject,
        _structural_mutate,
        _multi_strategy,
    ])
    return bytes(strategy(data))


def _bit_flip(data):
    for _ in range(random.randint(1, 4)):
        pos = random.randint(0, len(data) - 1)
        bit = random.randint(0, 7)
        data[pos] ^= (1 << bit)
    return data


def _byte_arith(data):
    pos = random.randint(0, len(data) - 1)
    delta = random.randint(-35, 35)
    data[pos] = (data[pos] + delta) & 0xFF
    return data


INTERESTING_16 = [0, 1, 0x7F, 0x80, 0xFF, 0x100, 0x7FFF, 0x8000, 0xFFFF]


def _interesting_16(data):
    if len(data) < 2:
        return data
    pos = random.randint(0, len(data) - 2)
    val = random.choice(INTERESTING_16)
    struct.pack_into("<H", data, pos, val)
    return data


def _desc_flags(data):
    """Randomize the flags field of a random descriptor."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs == 0:
        return data
    idx = random.randint(0, num_descs - 1)
    offset = HEADER_SIZE + idx * DESC_SIZE + 4  # flags is at +4 in desc
    if offset + 2 <= len(data):
        val = random.randint(0, 0xFFFF)
        struct.pack_into("<H", data, offset, val)
    return data


def _avail_corrupt(data):
    """Corrupt avail_idx or an avail ring entry."""
    # Overwrite avail_idx (bytes 4-5 in header)
    val = random.randint(0, 0xFFFF)
    struct.pack_into("<H", data, 4, val)
    return data


def _payload_noise(data):
    """Write random bytes into the payload region."""
    start = random.randint(HEADER_SIZE, len(data) - 1)
    length = random.randint(1, min(32, len(data) - start))
    for i in range(length):
        data[start + i] = random.randint(0, 255)
    return data


def _chain_shuffle(data):
    """Swap next pointers between two random descriptors."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs < 2:
        return data
    a, b = random.sample(range(num_descs), 2)
    off_a = HEADER_SIZE + a * DESC_SIZE + 6  # next is at +6 in desc (len:4 + flags:2)
    off_b = HEADER_SIZE + b * DESC_SIZE + 6
    if off_a + 2 <= len(data) and off_b + 2 <= len(data):
        va = struct.unpack_from("<H", data, off_a)[0]
        vb = struct.unpack_from("<H", data, off_b)[0]
        struct.pack_into("<H", data, off_a, vb)
        struct.pack_into("<H", data, off_b, va)
    return data


# Module-level corpus reference for splice mutation
_corpus_ref = []


def _splice_corpus(data):
    """Crossover with another corpus entry at a random boundary."""
    if not _corpus_ref:
        return _bit_flip(data)
    other = bytearray(random.choice(_corpus_ref))
    if len(other) != len(data):
        other = (other + bytearray(len(data)))[:len(data)]
    # Pick a crossover point
    point = random.randint(1, len(data) - 1)
    data[point:] = other[point:]
    return data


def _grow_desc(data):
    """Add a descriptor by incrementing num_descs."""
    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, data, 0)
    # Don't grow beyond what fits
    max_descs = (BLOB_SIZE - HEADER_SIZE - ac * 2) // DESC_SIZE
    if nd >= max_descs or nd >= 128:
        return data
    # Increment num_descs
    nd += 1
    struct.pack_into(HEADER_FMT, data, 0, qs, nd, ai, ac)
    # Write a random descriptor at the new slot
    off = HEADER_SIZE + (nd - 1) * DESC_SIZE
    if off + DESC_SIZE <= len(data):
        length = random.choice([1, 16, 512, 4096])
        flags = random.choice([0x00, 0x01, 0x02, 0x03])
        next_idx = random.randint(0, nd - 1)
        struct.pack_into(DESC_FMT, data, off, length, flags, next_idx)
    return data


def _shrink_desc(data):
    """Remove the last descriptor by decrementing num_descs."""
    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, data, 0)
    if nd <= 1:
        return data
    nd -= 1
    struct.pack_into(HEADER_FMT, data, 0, qs, nd, ai, ac)
    return data


def _header_corrupt(data):
    """Corrupt the virtio_blk_req header fields (type, ioprio, sector).

    Targets the first 16 bytes of the payload region which corresponds
    to the device-level request header that gets mapped from descriptor 0.
    """
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    # Payload starts after header + descs + avail entries
    payload_off = HEADER_SIZE + num_descs * DESC_SIZE + hdr[3] * 2
    if payload_off + 16 > len(data):
        return _bit_flip(data)
    field = random.choice(["type", "ioprio", "sector"])
    if field == "type":
        val = random.choice([0, 1, 4, 5, 8, 11, 13, 0xFF, 0x7FFFFFFF, 0x80000000])
        struct.pack_into("<I", data, payload_off, val)
    elif field == "ioprio":
        struct.pack_into("<I", data, payload_off + 4, random.randint(0, 0xFFFFFFFF))
    else:
        struct.pack_into("<Q", data, payload_off + 8, random.choice([
            0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0xFFFFFFFFFFFFFFFF,
        ]))
    return data


def _avail_ring_replay(data):
    """Duplicate an avail ring entry, causing the same head to be processed twice."""
    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, data, 0)
    if ac < 1 or nd < 1:
        return data
    avail_start = HEADER_SIZE + nd * DESC_SIZE
    if avail_start + ac * 2 > len(data):
        return data
    # Read the first entry and duplicate it into a second slot
    first_entry = struct.unpack_from("<H", data, avail_start)[0]
    if ac < 2:
        # Grow avail_count to make room
        ac = 2
        struct.pack_into(HEADER_FMT, data, 0, qs, nd, ai, ac)
    slot = random.randint(1, ac - 1)
    off = avail_start + slot * 2
    if off + 2 <= len(data):
        struct.pack_into("<H", data, off, first_entry)
    return data


INTERESTING_ADDRS = [0, 1, 0xFFF, 0x1000, 0xDEAD000, 0x7FFFFFFF, 0xFFFFFFFF]


def _desc_addr_mutate(data):
    """Replace a descriptor's implied address with an interesting value.

    Since the blob format doesn't carry full 64-bit addrs (the guest binary
    builds them), we corrupt the len field to trigger boundary conditions
    in addr+len overflow checks.
    """
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs == 0:
        return data
    idx = random.randint(0, num_descs - 1)
    off = HEADER_SIZE + idx * DESC_SIZE
    if off + 4 <= len(data):
        val = random.choice(INTERESTING_ADDRS)
        struct.pack_into("<I", data, off, val)
    return data


def _queue_size_mutate(data):
    """Alter queue_size to invalid values."""
    vals = [0, 1, 3, 7, 15, 127, 255, 256, 512, 1024, 32768, 65535]
    struct.pack_into("<H", data, 0, random.choice(vals))
    return data


def _endian_swap(data):
    """Swap byte order of a random 16 or 32-bit field."""
    if len(data) < 4:
        return data
    width = random.choice([2, 4])
    pos = random.randint(0, len(data) - width)
    chunk = data[pos:pos + width]
    data[pos:pos + width] = chunk[::-1]
    return data


def _zero_fill_region(data):
    """Zero out a random contiguous region."""
    start = random.randint(0, len(data) - 1)
    length = random.randint(1, min(64, len(data) - start))
    data[start:start + length] = b'\x00' * length
    return data


def _duplicate_desc(data):
    """Copy one descriptor over another (aliased buffer)."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs < 2:
        return data
    src, dst = random.sample(range(num_descs), 2)
    src_off = HEADER_SIZE + src * DESC_SIZE
    dst_off = HEADER_SIZE + dst * DESC_SIZE
    if src_off + DESC_SIZE <= len(data) and dst_off + DESC_SIZE <= len(data):
        data[dst_off:dst_off + DESC_SIZE] = data[src_off:src_off + DESC_SIZE]
    return data


def _indirect_inject(data):
    """Turn a normal descriptor into an indirect one by setting INDIRECT flag."""
    hdr = struct.unpack_from(HEADER_FMT, data, 0)
    num_descs = min(hdr[1], 128)
    if num_descs == 0:
        return data
    idx = random.randint(0, num_descs - 1)
    flags_off = HEADER_SIZE + idx * DESC_SIZE + 4  # flags at +4
    if flags_off + 2 <= len(data):
        flags = struct.unpack_from("<H", data, flags_off)[0]
        flags |= 0x04  # VIRTQ_DESC_F_INDIRECT
        struct.pack_into("<H", data, flags_off, flags)
    return data


def _multi_strategy(data):
    """Apply 2-3 mutations in sequence for deeper exploration."""
    strategies = [
        _bit_flip, _byte_arith, _interesting_16, _desc_flags,
        _avail_corrupt, _payload_noise, _chain_shuffle,
        _desc_addr_mutate, _queue_size_mutate, _zero_fill_region,
    ]
    count = random.randint(2, 3)
    for _ in range(count):
        data = bytearray(random.choice(strategies)(data))
    return data


# --- Structure-aware mutation ---
#
# The byte-level strategies above edit a flat bytearray with fixed offset
# math. Changing num_descs or avail_count in the header does not move the
# descriptor, avail, and payload regions, so the layout silently desyncs.
# VqBlob parses a blob into a virtqueue object, lets operators mutate at
# the structural level (descriptors, chains, avail ring, header), then
# serializes back with a consistent byte layout. Semantic adversariality
# (out of range heads, chain loops, oversized lengths, num_descs greater
# than queue_size) is preserved; only the on-disk framing stays coherent
# so the guest parser reads exactly what the operator intended.

# Mirror the C harness clamps in lib/fuzz_input.h.
MAX_DESCS = 128       # FUZZ_MAX_DESCS
MAX_AVAIL = 256       # FUZZ_MAX_QUEUE_SIZE

# Structural operators only grow the rings, which would ratchet a blob to
# the hard maximum over successive mutations. A saturated blob makes the
# VMM process hundreds of request heads of long chains per run, wedging
# and hitting the timeout far more often. Keep structural blobs light: a
# handful of descriptors and heads still expresses chains, loops, and
# indirect tables, and num_descs above the default queue_size of 16.
SOFT_DESCS = 16
SOFT_AVAIL = 16

_F_NEXT = 0x01
_F_WRITE = 0x02
_F_INDIRECT = 0x04

# Virtio dictionary: lengths and flag combinations worth steering toward.
STRUCT_LENS = [0, 1, 15, 16, 17, 512, 4095, 4096,
               0xFFFF, 0x10000, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF]
STRUCT_FLAGS = [0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
                0x0F, 0x8000, 0xFFFF]


class VqBlob:
    """Structured view of a fuzz blob: header, descriptors, avail, payload."""

    def __init__(self, queue_size, avail_idx, descs, avail_ring, payload):
        self.queue_size = queue_size
        self.avail_idx = avail_idx
        self.descs = descs            # list of [len, flags, next]
        self.avail_ring = avail_ring  # list of int (head indices)
        self.payload = bytes(payload)

    @classmethod
    def parse(cls, blob):
        """Tolerant parse mirroring the C side: clamp counts, stop at EOF."""
        blob = bytes(blob)
        if len(blob) < HEADER_SIZE:
            blob = blob + b"\x00" * (HEADER_SIZE - len(blob))
        qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, blob, 0)
        nd = min(nd, MAX_DESCS)
        ac = min(ac, MAX_AVAIL)

        off = HEADER_SIZE
        descs = []
        for _ in range(nd):
            if off + DESC_SIZE > len(blob):
                break
            descs.append(list(struct.unpack_from(DESC_FMT, blob, off)))
            off += DESC_SIZE

        avail_ring = []
        for _ in range(ac):
            if off + 2 > len(blob):
                break
            avail_ring.append(struct.unpack_from("<H", blob, off)[0])
            off += 2

        return cls(qs, ai, descs, avail_ring, blob[off:])

    def serialize(self):
        """Re-emit a BLOB_SIZE blob, trimming so every region fits."""
        descs = [
            (d[0] & 0xFFFFFFFF, d[1] & 0xFFFF, d[2] & 0xFFFF)
            for d in self.descs[:MAX_DESCS]
        ]
        avail = [v & 0xFFFF for v in self.avail_ring[:MAX_AVAIL]]

        def _fits():
            return (HEADER_SIZE + len(descs) * DESC_SIZE
                    + len(avail) * 2) <= BLOB_SIZE

        while not _fits() and avail:
            avail.pop()
        while not _fits() and descs:
            descs.pop()

        cap = BLOB_SIZE - HEADER_SIZE - len(descs) * DESC_SIZE - len(avail) * 2
        payload = self.payload[:max(0, cap)]
        return make_blob(self.queue_size & 0xFFFF, descs,
                         self.avail_idx & 0xFFFF, avail, payload)


def _op_set_len(vq):
    """Set a descriptor length to a boundary value."""
    if not vq.descs:
        return
    vq.descs[random.randrange(len(vq.descs))][0] = random.choice(STRUCT_LENS)


def _op_set_flags(vq):
    """Replace a descriptor's flags with an interesting combination."""
    if not vq.descs:
        return
    vq.descs[random.randrange(len(vq.descs))][1] = random.choice(STRUCT_FLAGS)


def _op_make_chain(vq):
    """Link every descriptor into a single NEXT chain 0->1->...->n-1."""
    n = len(vq.descs)
    if n < 2:
        return
    for i in range(n - 1):
        vq.descs[i][1] |= _F_NEXT
        vq.descs[i][2] = i + 1
    vq.descs[n - 1][1] &= ~_F_NEXT


def _op_make_loop(vq):
    """Point a descriptor's NEXT back to itself or an earlier slot."""
    n = len(vq.descs)
    if n == 0:
        return
    i = random.randrange(n)
    vq.descs[i][1] |= _F_NEXT
    vq.descs[i][2] = random.randint(0, n - 1)


def _op_make_indirect(vq):
    """Mark a descriptor INDIRECT (clearing NEXT) with a table-like length."""
    if not vq.descs:
        return
    i = random.randrange(len(vq.descs))
    vq.descs[i][1] = (vq.descs[i][1] | _F_INDIRECT) & ~_F_NEXT
    vq.descs[i][0] = random.choice([0, 16, 17, 32, 256, 4096])


def _op_insert_desc(vq):
    """Insert a fresh descriptor at a random position."""
    if len(vq.descs) >= SOFT_DESCS:
        return
    length = random.choice(STRUCT_LENS)
    flags = random.choice(STRUCT_FLAGS)
    nxt = random.randint(0, len(vq.descs)) if vq.descs else 0
    vq.descs.insert(random.randint(0, len(vq.descs)), [length, flags, nxt])


def _op_clone_desc(vq):
    """Duplicate a descriptor, aliasing its buffer."""
    if not vq.descs or len(vq.descs) >= SOFT_DESCS:
        return
    i = random.randrange(len(vq.descs))
    vq.descs.insert(i, list(vq.descs[i]))


def _op_remove_desc(vq):
    """Drop a descriptor, keeping at least one."""
    if len(vq.descs) <= 1:
        return
    vq.descs.pop(random.randrange(len(vq.descs)))


def _op_avail_point(vq):
    """Aim an avail ring entry at a boundary head index."""
    if not vq.avail_ring:
        vq.avail_ring = [0]
    n = max(1, len(vq.descs))
    vq.avail_ring[random.randrange(len(vq.avail_ring))] = random.choice(
        [0, n - 1, n, n + 1, 0xFFFF])


def _op_dup_avail(vq):
    """Replay a head by duplicating an avail ring entry."""
    if not vq.avail_ring or len(vq.avail_ring) >= SOFT_AVAIL:
        return
    vq.avail_ring.append(vq.avail_ring[random.randrange(len(vq.avail_ring))])


def _op_remove_avail(vq):
    """Drop an avail ring entry, keeping at least one."""
    if len(vq.avail_ring) <= 1:
        return
    vq.avail_ring.pop(random.randrange(len(vq.avail_ring)))


def _op_avail_idx(vq):
    """Set avail_idx to a boundary value."""
    vq.avail_idx = random.choice(
        [0, 1, len(vq.avail_ring), vq.queue_size,
         (vq.queue_size + 1) & 0xFFFF, 0xFFFF])


def _op_queue_size(vq):
    """Set queue_size to an invalid or boundary value."""
    vq.queue_size = random.choice(
        [0, 1, 3, 7, 15, 127, 256, 512, 1024, 32768, 65535])


_STRUCT_OPS = [
    _op_set_len, _op_set_flags, _op_make_chain, _op_make_loop,
    _op_make_indirect, _op_insert_desc, _op_clone_desc, _op_remove_desc,
    _op_avail_point, _op_dup_avail, _op_remove_avail, _op_avail_idx,
    _op_queue_size,
]


def _structural_mutate(data):
    """Parse into a VqBlob, apply structural operators, serialize back."""
    vq = VqBlob.parse(bytes(data))
    for _ in range(random.randint(1, 3)):
        random.choice(_STRUCT_OPS)(vq)
    # Cap ring sizes so a parent that arrived saturated does not keep its
    # weight; structural exploration needs variety, not maximum length.
    del vq.descs[SOFT_DESCS:]
    del vq.avail_ring[SOFT_AVAIL:]
    return bytearray(vq.serialize())


# --- Coverage ---

def collect_coverage(vmm_binary, profdata_path, profraw_dir):
    """Merge profraw files and return set of covered regions."""
    profraw_files = [
        os.path.join(profraw_dir, f)
        for f in os.listdir(profraw_dir)
        if f.endswith(".profraw")
    ]
    if not profraw_files:
        return set()

    merge_cmd = [
        "llvm-profdata", "merge", "-sparse",
        *profraw_files, "-o", profdata_path
    ]
    result = subprocess.run(merge_cmd, capture_output=True)
    if result.returncode != 0:
        return set()

    export_cmd = [
        "llvm-cov", "export", vmm_binary,
        f"-instr-profile={profdata_path}",
        "-format=text"
    ]
    result = subprocess.run(export_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        return set()

    try:
        cov = json.loads(result.stdout)
    except json.JSONDecodeError:
        return set()

    edges = set()
    for datum in cov.get("data", []):
        for func in datum.get("functions", []):
            for region in func.get("regions", []):
                if len(region) >= 7 and region[4] > 0:  # count > 0
                    # (file_id, line_start, col_start, line_end, col_end)
                    edge = (func.get("name", ""), region[0], region[1],
                            region[2], region[3])
                    edges.add(edge)
    return edges


# --- VMM Runner ---

def find_fuzz_section_offset(elf_path):
    """Find the file offset of .fuzz_input section in the ELF."""
    result = subprocess.run(
        ["readelf", "-S", elf_path],
        capture_output=True, text=True
    )
    for line in result.stdout.splitlines():
        if ".fuzz_input" in line:
            parts = line.split()
            # Section header: [Nr] Name Type Addr Off Size ...
            # The offset is typically the 5th or 6th field
            for i, p in enumerate(parts):
                if p == ".fuzz_input":
                    # Offset is 2 fields after the address
                    # Format: [22] .fuzz_input PROGBITS addr offset size ...
                    offset_str = parts[i + 3]  # skip Type, Addr → Offset
                    return int(offset_str, 16)
    return None


def patch_blob(elf_path, blob, section_offset):
    """Write blob bytes directly into the ELF at section offset."""
    with open(elf_path, "r+b") as f:
        f.seek(section_offset)
        f.write(blob)


def build_initramfs(fuzz_binary, output_path):
    """Build a minimal initramfs containing just the fuzz binary as /init."""
    tmpdir = tempfile.mkdtemp(prefix="vvfuzz_")
    try:
        for d in ["proc", "sys", "dev"]:
            os.makedirs(os.path.join(tmpdir, d))
        shutil.copy2(fuzz_binary, os.path.join(tmpdir, "init"))
        # Strip
        subprocess.run(["strip", os.path.join(tmpdir, "init")],
                       capture_output=True)
        # Build cpio
        find = subprocess.Popen(
            ["find", "."], cwd=tmpdir, stdout=subprocess.PIPE
        )
        cpio = subprocess.Popen(
            ["cpio", "-o", "-H", "newc"],
            cwd=tmpdir, stdin=find.stdout, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL
        )
        find.stdout.close()
        gzip = subprocess.Popen(
            ["gzip"], stdin=cpio.stdout, stdout=open(output_path, "wb"),
            stderr=subprocess.DEVNULL
        )
        cpio.stdout.close()
        gzip.wait()
        cpio.wait()
        find.wait()
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def _fetch_kernel():
    """Return path to guest kernel, downloading if not cached."""
    result = subprocess.run(
        [os.path.join(_SCRIPT_DIR, "run"), "fetch-kernel"],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        sys.exit(f"Failed to fetch kernel: {result.stderr.strip()}")
    return result.stdout.strip()


def run_vmm(vmm_path, initramfs_path, profraw_dir, timeout=3,
            kernel_path=None, disk_path=None, cpus=1, memory="128M"):
    """Boot the VMM with the fuzz initramfs. Returns (exit_code, crashed)."""
    if kernel_path:
        kernel = kernel_path
    else:
        kernel = _fetch_kernel()

    # Create a small disk image
    if disk_path:
        disk = disk_path
    else:
        disk = os.path.join(profraw_dir, "disk.raw")
    if not os.path.exists(disk):
        with open(disk, "wb") as f:
            f.seek(64 * 1024 * 1024 - 1)
            f.write(b"\x00")

    env = os.environ.copy()
    env["LLVM_PROFILE_FILE"] = os.path.join(profraw_dir, "%p.profraw")

    cmd = [
        vmm_path,
        "--kernel", kernel,
        "--initramfs", initramfs_path,
        "--disk", f"path={disk}",
        "--cpus", f"boot={cpus}",
        "--memory", f"size={memory}",
        "--serial", "off",
        "--console", "off",
        "--cmdline", "console=hvc0 initcall_blacklist=virtio_blk_init",
        "--seccomp", "false",
    ]

    try:
        result = subprocess.run(
            cmd, timeout=timeout, capture_output=True, env=env
        )
        crashed = result.returncode not in (0, 3)  # 3 = isa-debug-exit
        output = result.stderr.decode(errors="replace")
        # A VMM built with LeakSanitizer aborts its own atexit leak scan
        # when its StopTheWorld ptrace attach is denied (the VMM is non
        # dumpable, so a same uid tracer gets EPERM), exiting non zero
        # even though the run was clean. Do not count that teardown
        # artifact as a crash. A genuine sanitizer finding is preserved
        # because _is_sanitizer_ptrace_artifact only matches when no real
        # error report is present. Run with --apply-sysconfig to grant
        # CAP_SYS_PTRACE and remove the artifact at the source.
        if crashed and _is_sanitizer_ptrace_artifact(output):
            crashed = False
        return result.returncode, crashed, output
    except subprocess.TimeoutExpired:
        return -1, True, ""


