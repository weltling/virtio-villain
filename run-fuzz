def cmd_decode(args):
    """Decode and print the contents of a fuzz blob."""
    for path in args.blobs:
        container = open(path, "rb").read()
        print(f"{path}:")
        try:
            fb = FuzzBlob.parse(container)
        except ValueError as e:
            print(f"  invalid blob: {e}")
            print()
            continue
        print(f"  segments={len(fb.segments)}")
        for si, seg in enumerate(fb.segments):
            blob = seg.vq.serialize()
            qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, blob, 0)
            print(f"  segment[{si}] device=0x{seg.device_id:04x} "
                  f"queue={seg.queue_index}")
            print(f"    queue_size={qs} num_descs={nd} "
                  f"avail_idx={ai} avail_count={ac}")
            off = HEADER_SIZE
            for i in range(nd):
                if off + DESC_SIZE > len(blob):
                    print(f"    desc[{i}]: <truncated>")
                    break
                dl, df, dn = struct.unpack_from(DESC_FMT, blob, off)
                print(f"    desc[{i}]: len={dl} flags=0x{df:04x} next={dn}")
                off += DESC_SIZE
            avail_off = HEADER_SIZE + nd * DESC_SIZE
            for i in range(ac):
                if avail_off + 2 > len(blob):
                    break
                v, = struct.unpack_from("<H", blob, avail_off)
                print(f"    avail[{i}]: {v}")
                avail_off += 2
            payload_off = HEADER_SIZE + nd * DESC_SIZE + ac * 2
            payload_len = len(blob) - payload_off
            nonzero = sum(1 for b in blob[payload_off:] if b != 0)
            print(f"    payload: {payload_len} bytes ({nonzero} non-zero)")
            for note in _annotate_blob(blob):
                print(f"    \u26a0 {note}")
        print()


# Mapping from short device name (used as test directory and CLI option)
# to (test name prefix, VIRTIO_PCI_DEVICE_* macro, device id). The prefix
# must match the convention enforced by the run script's PREFIX_DIR table.
# The macro is emitted verbatim into generated C; the id matches a fuzz
# blob segment back to a device.
_DEVICE_MAP = {
    "blk":      ("B",   "VIRTIO_PCI_DEVICE_BLK",      0x1042),
    "net":      ("N",   "VIRTIO_PCI_DEVICE_NET",      0x1041),
    "console":  ("C",   "VIRTIO_PCI_DEVICE_CONSOLE",  0x1043),
    "rng":      ("RNG", "VIRTIO_PCI_DEVICE_RNG",      0x1044),
    "balloon":  ("L",   "VIRTIO_PCI_DEVICE_BALLOON",  0x1045),
    "vsock":    ("V",   "VIRTIO_PCI_DEVICE_VSOCK",    0x1053),
    "iommu":    ("I",   "VIRTIO_PCI_DEVICE_IOMMU",    0x1057),
    "mem":      ("R",   "VIRTIO_PCI_DEVICE_MEM",      0x1058),
    "pmem":     ("E",   "VIRTIO_PCI_DEVICE_PMEM",     0x105b),
    "watchdog": ("D",   "VIRTIO_PCI_DEVICE_WATCHDOG", 0x1063),
    "rtc":      ("RTC", "VIRTIO_PCI_DEVICE_RTC",      0x1051),
    "fs":       ("F",   "VIRTIO_PCI_DEVICE_FS",       0x105a),
}

# Fuzz-generated tests continue the per-device numbering. They live in a
# fuzz/ subdirectory but share the ID space with handwritten tests so the
# sequence stays gap-free and meaningful at a glance.


def _next_fuzz_id(device, prefix):
    """Find the next free ID for a fuzz replay test for tests/<device>.

    Scans every <prefix><nnnn>_*.c under tests/<device>/ (recursively,
    so handwritten tests at the top level and existing fuzz replays in
    fuzz/ both count) and returns the highest used number plus one.
    """
    dev_dir = os.path.join(_SCRIPT_DIR, "tests", device)
    used = set()
    pat = re.compile(r"^" + prefix.lower() + r"(\d+)_.*\.c$", re.IGNORECASE)
    if os.path.isdir(dev_dir):
        for root, _dirs, files in os.walk(dev_dir):
            for name in files:
                m = pat.match(name)
                if m:
                    used.add(int(m.group(1)))
    n = (max(used) + 1) if used else 1
    return f"{prefix}{n:04d}"


def _format_payload_bytes(payload):
    """Format payload as a C array body, 12 bytes per line."""
    if not payload:
        return ""
    lines = []
    for i in range(0, len(payload), 12):
        chunk = payload[i:i + 12]
        lines.append("    " + ", ".join(f"0x{b:02x}" for b in chunk) + ",")
    return "\n".join(lines)


def _device_from_segment(segment):
    """Return the device name for a fuzz blob segment."""
    for name, (_prefix, _macro, device_id) in _DEVICE_MAP.items():
        if device_id == segment.device_id:
            return name
    raise ValueError(f"unknown virtio device id 0x{segment.device_id:04x}")


def _blob_device_name(blob):
    """Return the device name a fuzz blob targets, from its first segment."""
    return _device_from_segment(FuzzBlob.parse(blob).segments[0])


def _device_dir(base, device):
    """Return the per-device subdirectory of a corpus or crashes root."""
    return os.path.join(base, device)


def make_device_seed(device):
    """Build a minimal seed blob targeting the given device on queue 0."""
    device_id = _DEVICE_MAP[device][2]
    vq = FuzzBlob.parse(make_seed()).segments[0].vq
    return FuzzBlob([FuzzSegment(device_id, 0, vq)]).serialize()


def _crash_path(crashes_dir, blob):
    """Return the per-device path a crash blob is saved under."""
    dev_dir = _device_dir(crashes_dir, _blob_device_name(blob))
    os.makedirs(dev_dir, exist_ok=True)
    blob_hash = hashlib.sha256(blob).hexdigest()[:16]
    return os.path.join(dev_dir, f"crash_{blob_hash}.bin")


def _corpus_path(corpus_dir, blob, iteration):
    """Return the per-device path a new corpus blob is saved under."""
    dev_dir = _device_dir(corpus_dir, _blob_device_name(blob))
    os.makedirs(dev_dir, exist_ok=True)
    blob_hash = hashlib.sha256(blob).hexdigest()[:16]
    return os.path.join(dev_dir, f"gen_{iteration:06d}_{blob_hash}.bin")


def cmd_gen_test(args):
    """Generate a C test from a fuzz blob, mirroring fuzz.c semantics."""
    container = open(args.blob, "rb").read()
    try:
        fb = FuzzBlob.parse(container)
    except ValueError as e:
        sys.exit(f"invalid blob: {e}")

    if args.device:
        device = args.device
    else:
        try:
            device = _device_from_segment(fb.segments[0])
        except ValueError as e:
            sys.exit(str(e))
    entry = _DEVICE_MAP.get(device)
    if entry is None:
        sys.exit(f"unknown device '{device}'. Known: "
                 + ", ".join(sorted(_DEVICE_MAP)))
    prefix, device_macro, _device_id = entry

    test_id = args.id or _next_fuzz_id(device, prefix)
    if not test_id.upper().startswith(prefix):
        sys.exit(f"test id '{test_id}' must start with prefix '{prefix}' "
                 f"for device '{device}'")
    test_id = test_id.upper()

    blob = fb.segments[0].vq.serialize()

    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, blob, 0)
    nd = min(nd, 128)
    ac = min(ac, 256)

    descs = []
    off = HEADER_SIZE
    for i in range(nd):
        if off + DESC_SIZE > len(blob):
            nd = i
            break
        descs.append(struct.unpack_from(DESC_FMT, blob, off))
        off += DESC_SIZE

    avail_off = HEADER_SIZE + nd * DESC_SIZE
    avail = []
    for i in range(ac):
        if avail_off + 2 > len(blob):
            ac = i
            break
        avail.append(struct.unpack_from("<H", blob, avail_off)[0])
        avail_off += 2

    payload_off = HEADER_SIZE + nd * DESC_SIZE + ac * 2
    payload = blob[payload_off:]

    # Mirror fuzz.c: payload is contiguous, descriptors reference it by
    # cumulative offset, length is clamped so it never escapes the
    # allocation, and the offset wraps to 0 on overflow.
    payload_pages = max(1, (len(payload) + 4095) // 4096)
    payload_bytes_total = payload_pages * 4096

    desc_emit = []
    offset = 0
    for i, (l, f, n) in enumerate(descs):
        clamped = l
        if offset + clamped > payload_bytes_total:
            clamped = payload_bytes_total - offset
        desc_emit.append((i, offset, clamped, f, n))
        offset += clamped
        if offset >= payload_bytes_total:
            offset = 0

    # File path
    test_dir = os.path.join(_SCRIPT_DIR, "tests", device, "fuzz")
    os.makedirs(test_dir, exist_ok=True)
    func_name = "test_" + test_id.lower() + "_replay"
    out_path = os.path.join(test_dir, f"{test_id.lower()}_replay.c")
    if os.path.exists(out_path) and not args.force:
        sys.exit(f"refusing to overwrite {out_path} (use --force)")

    payload_block = _format_payload_bytes(bytes(payload[:payload_bytes_total]))
    desc_lines = []
    for i, off, l, f, n in desc_emit:
        desc_lines.append(
            f"    vring_raw_set_desc(vr, {i}, payload_phys + {off}, "
            f"{l}, 0x{f:04x}, {n});"
        )
    avail_lines = [
        f"    vring_raw_set_avail(vr, {i}, {v});"
        for i, v in enumerate(avail)
    ]

    description = f"fuzz replay {os.path.basename(args.blob)}"

    content = f"""/* SPDX-License-Identifier: Apache-2.0 */
/*
 * {test_id}: {description}
 *
 * Generated by run-fuzz gen-test from {os.path.basename(args.blob)}.
 * Mirrors the bin/fuzz.c replay path: a contiguous payload region is
 * allocated and each descriptor points into it by cumulative offset.
 */
#include "tests/test.h"
#include "lib/util.h"
#include "lib/vring.h"
#include "lib/virtio_pci.h"

#include <string.h>
#include <unistd.h>

static const uint8_t fuzz_payload[{payload_bytes_total}] = {{
{payload_block}
}};

static test_result_t {func_name}(struct virtio_dev *dev, struct vring *vr)
{{
    uint32_t pages = ({payload_bytes_total} + 4095) / 4096;
    uint8_t *payload = vv_alloc_pages(pages);
    memcpy(payload, fuzz_payload, sizeof(fuzz_payload));
    uint64_t payload_phys = vv_virt_to_phys(payload);

{chr(10).join(desc_lines)}

{chr(10).join(avail_lines)}

    vring_raw_set_avail_idx(vr, {ai});

    return vv_kick_and_wait(dev, vr, 0, VV_TIMEOUT_MS);
}}

REGISTER_TEST({test_id}, {device_macro}, {func_name},
              "{description}",
              VIRTIO_SPEC_V1_2, "");
"""
    with open(out_path, "w") as f:
        f.write(content)
    print(f"wrote {out_path}")


# Valid descriptor flags: NEXT=0x01, WRITE=0x02, INDIRECT=0x04
_VALID_FLAGS = 0x0007

# Cap per blob anomaly notes so a mutated count cannot flood the output.
_MAX_BLOB_NOTES = 32


def _annotate_blob(blob):
    """Return list of anomaly annotations for a blob."""
    notes = []
    if len(blob) < HEADER_SIZE:
        notes.append("TRUNCATED: blob shorter than header")
        return notes

    qs, nd, ai, ac = struct.unpack_from(HEADER_FMT, blob, 0)

    if nd > qs:
        notes.append(f"num_descs={nd} > queue_size={qs}")
    if ai > qs:
        notes.append(f"avail_idx={ai} > queue_size={qs} (OVERFLOW)")

    off = HEADER_SIZE
    for i in range(nd):
        if off + DESC_SIZE > len(blob):
            break
        if len(notes) >= _MAX_BLOB_NOTES:
            notes.append(f"... descriptor annotations truncated "
                         f"(num_descs={nd})")
            return notes
        l, f, n = struct.unpack_from(DESC_FMT, blob, off)
        undefined = f & ~_VALID_FLAGS
        if undefined:
            notes.append(f"desc[{i}]: undefined flag bits 0x{undefined:04x}")
        if (f & 0x01) and n == i:
            notes.append(f"desc[{i}]: next={n} SELF-LOOP")
        elif (f & 0x01) and n >= nd:
            notes.append(f"desc[{i}]: next={n} OOB (num_descs={nd})")
        if (f & 0x02) and (f & 0x04):
            notes.append(f"desc[{i}]: WRITE+INDIRECT (invalid combo)")
        if l == 0:
            notes.append(f"desc[{i}]: len=0 (zero-length descriptor)")
        off += DESC_SIZE

    # Check avail ring entries
    avail_off = HEADER_SIZE + nd * DESC_SIZE
    for i in range(ac):
        if avail_off + 2 > len(blob):
            break
        if len(notes) >= _MAX_BLOB_NOTES:
            notes.append(f"... avail annotations truncated (avail_count={ac})")
            return notes
        v, = struct.unpack_from("<H", blob, avail_off)
        if v >= nd:
            notes.append(f"avail[{i}]={v} OOB (num_descs={nd})")
        avail_off += 2

    # Detect chain cycles
    for start in range(min(nd, ac)):
        # Follow chain from avail ring head
        avail_entry_off = HEADER_SIZE + nd * DESC_SIZE + start * 2
        if avail_entry_off + 2 > len(blob):
            break
        head, = struct.unpack_from("<H", blob, avail_entry_off)
        if head >= nd:
            continue
        seen = set()
        idx = head
        cycle = False
        while idx < nd:
            if idx in seen:
                cycle = True
                break
            seen.add(idx)
            d_off = HEADER_SIZE + idx * DESC_SIZE
            if d_off + DESC_SIZE > len(blob):
                break
            _, flags, nxt = struct.unpack_from(DESC_FMT, blob, d_off)
            if not (flags & 0x01):
                break
            idx = nxt
        if cycle:
            notes.append(f"chain from avail[{start}]={head}: CYCLE at desc[{idx}]")

    return notes


# Security triage helpers and the sanitizer noise filter live in the run
# module so the test runner and the fuzzer share one classification.
# Re-export them here for local use and for the selftest, which loads
# this module by path.
_is_sanitizer_noise_line = _run_mod._is_sanitizer_noise_line
_SECURITY_ORDER = _run_mod._SECURITY_ORDER
_CORRUPTION_MARKERS = _run_mod._CORRUPTION_MARKERS
_security_triage = _run_mod._security_triage


def _is_benign_rejection_line(line):
    """True if the line is the VMM gracefully rejecting a malformed
    descriptor chain rather than faulting.

    The VMM logs block request validation failures at ERROR level, for
    example "Need a data descriptor" or "Missing head descriptor" from
    its block request path. These mean the device correctly refused bad
    guest input, which is the desired outcome of a fuzz case, not a
    crash. They must not be mistaken for a genuine fault that masks the
    LeakSanitizer ptrace teardown artifact.
    """
    return "ERROR:block/src/io/request.rs:" in line


def _is_sanitizer_ptrace_artifact(output):
    """True if output is only the LeakSanitizer ptrace teardown abort.

    Requires the ptrace abort noise to be present and no genuine fault
    indicator on any other line, so a real AddressSanitizer or
    LeakSanitizer report, a VMM panic, a NEEDS_RESET, an ERROR log, or a
    seccomp kill is never masked even when LSan also fails to ptrace.
    Graceful block request rejections are not genuine faults and do not
    defeat the match.
    """
    if not output:
        return False
    has_ptrace_abort = False
    for line in output.splitlines():
        if _is_sanitizer_noise_line(line):
            has_ptrace_abort = True
            continue
        if _is_benign_rejection_line(line):
            continue
        low = line.lower()
        if ("panic" in line
                or "NEEDS_RESET" in line
                or "ERROR" in line
                or "runtime error:" in line
                or "seccomp" in low):
            return False
    return has_ptrace_abort


# Signals that mean the VMM process genuinely died rather than exited.
_FATAL_SIGNALS = {
    signal.SIGSEGV: "SIGSEGV",
    signal.SIGABRT: "SIGABRT",
    signal.SIGBUS: "SIGBUS",
    signal.SIGILL: "SIGILL",
    signal.SIGFPE: "SIGFPE",
}


def _fault_class(returncode, output):
    """Return a short fault class if the VMM genuinely faulted, else None.

    A genuine fault is a Rust panic, a sanitizer report (AddressSanitizer
    or a UBSan runtime error), a guest controlled corruption marker, or
    death by a fatal signal (SIGSEGV, SIGABRT, SIGBUS, SIGILL, SIGFPE).
    A clean exit, a guest reboot with a non zero code, a device
    NEEDS_RESET, and a handled ERROR log are not faults, because the
    fuzz guest feeds malformed input the VMM is meant to reject. The
    LeakSanitizer ptrace teardown abort is filtered as noise.
    """
    if output:
        if _is_sanitizer_ptrace_artifact(output):
            return None
        for line in output.splitlines():
            if _is_sanitizer_noise_line(line):
                continue
            low = line.lower()
            if "panic" in low:
                return line.strip()[:160]
            if ("addresssanitizer" in low
                    or "runtime error:" in low
                    or any(marker in line for marker in _CORRUPTION_MARKERS)):
                return line.strip()[:160]
    if returncode is not None and returncode < 0:
        name = _FATAL_SIGNALS.get(-returncode)
        if name:
            return f"fatal signal {name}"
    return None


def _classify_vmm_output(output, returncode=None):
    """Extract a short error class from VMM output for triage grouping."""
    if not output:
        if returncode is not None and returncode < 0:
            name = _FATAL_SIGNALS.get(-returncode)
            if name:
                return f"fatal signal {name}"
        return "timeout"
    if _is_sanitizer_ptrace_artifact(output):
        return "sanitizer ptrace teardown (not a crash)"
    for line in output.splitlines():
        if _is_sanitizer_noise_line(line):
            continue
        if "panicked" in line or "panic" in line:
            return line.strip()
        if "seccomp" in line.lower():
            return "seccomp violation"
        if "NEEDS_RESET" in line:
            return "device NEEDS_RESET (wedged)"
        if "ERROR" in line:
            # Extract the error message
            parts = line.split("ERROR:")
            if len(parts) > 1:
                return parts[-1].strip()[:120]
    if returncode is not None and returncode < 0:
        name = _FATAL_SIGNALS.get(-returncode)
        if name:
            return f"fatal signal {name}"
    return "exit code non-zero"


def _annotate_container(blob):
    """Annotate every segment of a versioned crash blob.

    The stored crash blob is the outer versioned container, so annotate
    each segment's virtqueue rather than misreading the container header
    as one queue.
    """
    try:
        fb = FuzzBlob.parse(blob)
    except ValueError as e:
        return [f"invalid blob: {e}"]
    notes = []
    for si, seg in enumerate(fb.segments):
        for note in _annotate_blob(seg.vq.serialize()):
            notes.append(f"segment[{si}] {note}")
    return notes


def _print_crash_detail(blob, vmm_output, crash_path):
    """Print decoded crash with annotations and VMM error."""
    notes = _annotate_container(blob)
    error_class = _classify_vmm_output(vmm_output)
    print(f"    class: {error_class}")
    if notes:
        for note in notes:
            print(f"    ⚠ {note}")
    # Show relevant VMM output lines (skip boilerplate WARN lines and
    # LeakSanitizer ptrace teardown noise).
    interesting = [ln.strip() for ln in vmm_output.splitlines()
                   if ("ERROR" in ln or "panic" in ln
                       or "seccomp" in ln.lower())
                   and not _is_sanitizer_noise_line(ln)]
    for line in interesting[:3]:
        print(f"    vmm: {line}")


def cmd_replay(args):
    """Replay a crash blob against the VMM."""
    _require_vmm(args.vmm)
    fuzz_binary = os.path.join(_SCRIPT_DIR, "target", "fuzz")
    if not os.path.exists(fuzz_binary):
        print("[*] Building fuzz guest...")
        result = subprocess.run(["make", "fuzz"], capture_output=True, text=True)
        if result.returncode != 0:
            sys.exit(f"Build failed: {result.stderr}")

    section_offset = find_fuzz_section_offset(fuzz_binary)
    if section_offset is None:
        sys.exit("Cannot find .fuzz_input section in fuzz binary")

    profraw_dir = tempfile.mkdtemp(prefix="vvfuzz_replay_")
    initramfs_path = os.path.join(profraw_dir, "initramfs.cpio.gz")

    for path in args.blobs:
        blob = open(path, "rb").read()
        patch_blob(fuzz_binary, blob, section_offset)
        build_initramfs(fuzz_binary, initramfs_path)

        print(f"[*] Replaying {path}...")
        exit_code, crashed, output, _timed_out = run_vmm(
            args.vmm, initramfs_path, profraw_dir, args.timeout,
            kernel_path=args.kernel, disk_path=args.disk
        )
        status = "CRASH" if crashed else "OK"
        print(f"    exit={exit_code} {status}")
        tier, rationale = _security_triage(output, exit_code)
        print(f"    security: {tier} -- {rationale}")
        if crashed:
            _print_crash_detail(blob, output, path)
        if getattr(args, "verbose", False):
            print("    --- full VMM stderr ---")
            for line in output.splitlines():
                print(f"    vmm: {line}")
            print("    --- end VMM stderr ---")

    shutil.rmtree(profraw_dir, ignore_errors=True)


# --- Flag constants used in tests ---
_FLAG_MAP = {
    "VRING_DESC_F_NEXT": 0x01,
    "VRING_DESC_F_WRITE": 0x02,
    "VRING_DESC_F_INDIRECT": 0x04,
    "VRING_DESC_F_AVAIL": 0x80,
    "VRING_DESC_F_USED": 0x8000,
}

# Common sizeof expressions
_SIZEOF_MAP = {
    "sizeof(*hdr)": 16,
    "sizeof(struct virtio_blk_req_hdr)": 16,
    "sizeof(struct virtio_net_hdr)": 12,
    "sizeof(struct virtio_net_hdr_v1)": 12,
    "sizeof(struct virtio_vsock_hdr)": 44,
}

import re as _re


def _parse_flags(expr):
    """Parse a flags expression like 'VRING_DESC_F_NEXT | VRING_DESC_F_WRITE'."""
    val = 0
    for token in expr.split("|"):
        token = token.strip()
        if token in _FLAG_MAP:
            val |= _FLAG_MAP[token]
        elif token.startswith("0x"):
            val |= int(token, 16)
        elif token.isdigit():
            val |= int(token)
    return val


def _parse_len(expr):
    """Parse a length expression."""
    expr = expr.strip()
    if expr in _SIZEOF_MAP:
        return _SIZEOF_MAP[expr]
    cleaned = expr.rstrip("UuLl")
    if cleaned.startswith("0x"):
        return int(cleaned, 16)
    try:
        return int(cleaned)
    except ValueError:
        # Try evaluating simple math
        for k, v in _SIZEOF_MAP.items():
            expr = expr.replace(k, str(v))
        try:
            return int(eval(expr))  # noqa: S307
        except Exception:
            return 16  # fallback


def _extract_seeds_from_file(path):
    """Extract vring layout from a test .c file and return a blob or None."""
    with open(path) as f:
        src = f.read()

    # Match vring_raw_set_desc(vr, idx, addr, len, flags, next)
    # The call often spans two lines
    src_flat = src.replace("\n", " ").replace("  ", " ")
    desc_pat = _re.compile(
        r"vring_raw_set_desc\s*\(\s*\w+\s*,\s*(\d+)\s*,\s*\w+\s*,"
        r"\s*([^,]+),\s*([^,]+),\s*(\d+)\s*\)"
    )
    avail_pat = _re.compile(
        r"vring_raw_set_avail\s*\(\s*\w+\s*,\s*(\d+)\s*,\s*(\d+)\s*\)"
    )
    avail_idx_pat = _re.compile(
        r"vring_raw_set_avail_idx\s*\(\s*\w+\s*,\s*(\d+)\s*\)"
    )

    descs_raw = desc_pat.findall(src_flat)
    if not descs_raw:
        return None

    # Build descriptor list indexed by position
    max_idx = max(int(d[0]) for d in descs_raw)
    descs = [(16, 0, 0)] * (max_idx + 1)  # (len, flags, next)
    for idx_s, len_s, flags_s, next_s in descs_raw:
        idx = int(idx_s)
        length = _parse_len(len_s)
        flags = _parse_flags(flags_s)
        next_idx = int(next_s)
        descs[idx] = (length, flags, next_idx)

    # Avail ring
    avail_entries = {}
    for idx_s, val_s in avail_pat.findall(src_flat):
        avail_entries[int(idx_s)] = int(val_s)
    avail_ring = [avail_entries.get(i, 0) for i in range(max(avail_entries.keys()) + 1)] \
        if avail_entries else [0]

    # Avail idx
    avail_idx_match = avail_idx_pat.findall(src_flat)
    avail_idx = int(avail_idx_match[-1]) if avail_idx_match else len(avail_ring)

    # Queue size (default 16 for blk)
    qs = 16

    # Build payload (just zeros, sized to cover descriptor lengths)
    total_payload = sum(d[0] for d in descs)
    cap = BLOB_SIZE - HEADER_SIZE - len(descs) * DESC_SIZE - len(avail_ring) * 2
    payload = b"\x00" * min(total_payload, cap)

    return make_blk_blob(make_blob(qs, descs, avail_idx, avail_ring, payload))


