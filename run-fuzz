def cmd_fuzz(args):
    """Main fuzzing loop."""
    _require_vmm(args.vmm)
    os.makedirs(args.corpus_dir, exist_ok=True)
    os.makedirs(args.crashes_dir, exist_ok=True)

    # Build the fuzz binary
    print("[*] Building fuzz guest...")
    result = subprocess.run(["make", "fuzz"], capture_output=True, text=True)
    if result.returncode != 0:
        sys.exit(f"Build failed: {result.stderr}")

    fuzz_binary = os.path.join(_SCRIPT_DIR, "target", "fuzz")
    section_offset = find_fuzz_section_offset(fuzz_binary)
    if section_offset is None:
        sys.exit("Cannot find .fuzz_input section in fuzz binary")

    print(f"[*] .fuzz_input section at offset 0x{section_offset:x}")

    # Select coverage tools that can actually read this VMM's profraw; fall
    # back to dumb fuzzing if none match (avoids silent edges=0 runs).
    if not args.no_coverage:
        if _vmm_has_coverage_instrumentation(args.vmm) is False:
            print("[!] VMM has no __llvm_profile symbols: it was not built "
                  "with coverage instrumentation, so coverage feedback will "
                  "find no edges and the corpus will not grow.\n"
                  "    Rebuild with RUSTFLAGS=\"-C instrument-coverage\" or "
                  "pass --no-coverage for a dumb run.")
        profdata_tool, cov_tool = select_coverage_tools(args.vmm)
        if not profdata_tool or not cov_tool:
            print("[!] no llvm-profdata/llvm-cov able to read this VMM's "
                  "coverage data; disabling coverage feedback.\n"
                  "    Install tools matching the toolchain that built the "
                  "VMM, e.g. for a nightly build:\n"
                  "    rustup component add llvm-tools-preview "
                  "--toolchain nightly")
            args.no_coverage = True
        else:
            print(f"[*] Coverage tools: {profdata_tool}")

    # Load or seed corpus
    corpus = []
    skipped = 0
    filtered = 0
    for path in glob.glob(os.path.join(args.corpus_dir, "**", "*.bin"),
                          recursive=True):
        with open(path, "rb") as fh:
            entry = fh.read()
        try:
            FuzzBlob.parse(entry)
        except ValueError:
            skipped += 1
            continue
        if args.device and _blob_device_name(entry) != args.device:
            filtered += 1
            continue
        corpus.append(entry)
    if skipped:
        print(f"[*] Skipped {skipped} corpus entries not in the "
              "current blob format")
    if filtered:
        print(f"[*] Skipped {filtered} corpus entries not targeting "
              f"{args.device}")
    if not corpus:
        seed = make_device_seed(args.device) if args.device else make_seed()
        corpus.append(seed)
        seed_dir = _device_dir(args.corpus_dir, _blob_device_name(seed))
        os.makedirs(seed_dir, exist_ok=True)
        with open(os.path.join(seed_dir, "seed_000.bin"), "wb") as fh:
            fh.write(seed)
        print("[*] Seeded corpus with 1 entry")
    else:
        print(f"[*] Loaded {len(corpus)} corpus entries")

    # Wire up corpus for splice mutation
    global _corpus_ref
    _corpus_ref = corpus

    # Fetch kernel once
    kernel = args.kernel or _fetch_kernel()

    jobs = args.jobs
    baseline_edges = set()
    stats = {"iterations": 0, "crashes": 0, "new_edges": 0,
             "corpus_size": len(corpus)}
    lock = threading.Lock()

    # Set up per-worker state
    worker_dirs = []
    for w in range(jobs):
        wdir = tempfile.mkdtemp(prefix=f"vvfuzz_w{w}_")
        wb = os.path.join(wdir, "fuzz")
        shutil.copy2(fuzz_binary, wb)
        initramfs = os.path.join(wdir, "initramfs.cpio.gz")
        disk = os.path.join(wdir, "disk.raw")
        with open(disk, "wb") as f:
            f.seek(64 * 1024 * 1024 - 1)
            f.write(b"\x00")
        worker_dirs.append({
            "dir": wdir,
            "binary": wb,
            "initramfs": initramfs,
            "disk": disk,
        })

    print(f"[*] Starting fuzzing: {args.iterations} iterations, "
          f"jobs={jobs}, timeout={args.timeout}s, "
          f"cpus={args.cpus}, memory={args.memory}")
    print(f"[*] VMM={args.vmm}")
    print(f"[*] Corpus: {args.corpus_dir}/, Crashes: {args.crashes_dir}/")
    if args.device:
        print(f"[*] Device focus: {args.device}")
    print()

    start_time = time.time()
    stop = threading.Event()

    def _worker(iteration, worker_id):
        """Run one fuzz iteration. Returns (crashed, blob, vmm_output, edges)."""
        if stop.is_set():
            return None
        w = worker_dirs[worker_id % jobs]

        with lock:
            parent = random.choice(corpus)
        blob = mutate(parent)

        # Patch into this worker's binary
        patch_blob(w["binary"], blob, section_offset)

        # Rebuild initramfs
        build_initramfs(w["binary"], w["initramfs"])

        # Clear old profraw
        for fname in os.listdir(w["dir"]):
            if fname.endswith(".profraw"):
                os.unlink(os.path.join(w["dir"], fname))

        # Run VMM
        exit_code, crashed, vmm_output, timed_out = run_vmm(
            args.vmm, w["initramfs"], w["dir"], args.timeout,
            kernel_path=kernel, disk_path=w["disk"],
            cpus=args.cpus, memory=args.memory
        )

        # A timeout under parallel load is usually a scheduling stall,
        # not a hang. Reconfirm with extra headroom before believing it.
        if timed_out and not args.no_confirm_timeouts:
            confirm_timeout = max(args.timeout * 3, 12)
            exit_code, crashed, vmm_output, timed_out = run_vmm(
                args.vmm, w["initramfs"], w["dir"], confirm_timeout,
                kernel_path=kernel, disk_path=w["disk"],
                cpus=args.cpus, memory=args.memory
            )

        # Collect coverage
        edges = set()
        if not args.no_coverage:
            profdata_path = os.path.join(w["dir"], "merged.profdata")
            edges = collect_coverage(args.vmm, profdata_path, w["dir"])

        return iteration, crashed, blob, vmm_output, edges

    try:
        if jobs == 1:
            # Sequential path (simpler, no threading overhead)
            for i in range(args.iterations):
                if stop.is_set():
                    break
                result = _worker(i, 0)
                if result is None:
                    break
                _, crashed, blob, vmm_output, edges = result
                stats["iterations"] += 1

                if crashed:
                    stats["crashes"] += 1
                    crash_path = _crash_path(args.crashes_dir, blob)
                    if not os.path.exists(crash_path):
                        with open(crash_path, "wb") as fh:
                            fh.write(blob)
                        print(f"\n[!] CRASH #{stats['crashes']} "
                              f"saved: {crash_path}")
                        _print_crash_detail(blob, vmm_output, crash_path)

                if not args.no_coverage and edges:
                    new_edges = edges - baseline_edges
                    if new_edges:
                        stats["new_edges"] += len(new_edges)
                        baseline_edges |= new_edges
                        corpus.append(blob)
                        stats["corpus_size"] = len(corpus)
                        corpus_path = _corpus_path(
                            args.corpus_dir, blob, i)
                        with open(corpus_path, "wb") as fh:
                            fh.write(blob)

                if (i + 1) % 10 == 0:
                    elapsed = time.time() - start_time
                    rate = stats["iterations"] / elapsed if elapsed > 0 else 0
                    print(f"[{i+1}/{args.iterations}] "
                          f"{rate:.1f} exec/s | "
                          f"corpus={stats['corpus_size']} | "
                          f"crashes={stats['crashes']} | "
                          f"edges={len(baseline_edges)}",
                          end="\r")
        else:
            # Parallel path: each worker owns a dedicated slot
            import queue
            slot_queue = queue.Queue()
            for s in range(jobs):
                slot_queue.put(s)

            def _parallel_worker(iteration):
                if stop.is_set():
                    return None
                slot = slot_queue.get()
                try:
                    return _worker(iteration, slot)
                finally:
                    slot_queue.put(slot)

            pool = ThreadPoolExecutor(max_workers=jobs)
            try:
                futures = {}
                for i in range(args.iterations):
                    if stop.is_set():
                        break
                    f = pool.submit(_parallel_worker, i)
                    futures[f] = i

                for future in as_completed(futures):
                    result = future.result()
                    if result is None:
                        continue
                    iteration, crashed, blob, vmm_output, edges = result

                    with lock:
                        stats["iterations"] += 1

                        if crashed:
                            stats["crashes"] += 1
                            crash_path = _crash_path(args.crashes_dir, blob)
                            if not os.path.exists(crash_path):
                                with open(crash_path, "wb") as fh:
                                    fh.write(blob)
                                print(f"\n[!] CRASH #{stats['crashes']} "
                                      f"saved: {crash_path}")
                                _print_crash_detail(
                                    blob, vmm_output, crash_path)

                        if not args.no_coverage and edges:
                            new_edges = edges - baseline_edges
                            if new_edges:
                                stats["new_edges"] += len(new_edges)
                                baseline_edges |= new_edges
                                corpus.append(blob)
                                stats["corpus_size"] = len(corpus)
                                corpus_path = _corpus_path(
                                    args.corpus_dir, blob, iteration)
                                with open(corpus_path, "wb") as fh:
                                    fh.write(blob)

                        done = stats["iterations"]
                        if done % 10 == 0:
                            elapsed = time.time() - start_time
                            rate = done / elapsed if elapsed > 0 else 0
                            print(
                                f"[{done}/{args.iterations}] "
                                f"{rate:.1f} exec/s | "
                                f"corpus={stats['corpus_size']} | "
                                f"crashes={stats['crashes']} | "
                                f"edges={len(baseline_edges)}",
                                end="\r")
            finally:
                # Never block on a running VM boot when interrupted.
                # Drop queued work and let live children die on the
                # shared SIGINT or their own timeout.
                pool.shutdown(wait=False, cancel_futures=True)

    except KeyboardInterrupt:
        stop.set()
        print("\n[*] Interrupted")
    finally:
        # A second Ctrl-C must not spew a traceback over the summary.
        try:
            elapsed = time.time() - start_time
            rate = stats["iterations"] / elapsed if elapsed > 0 else 0
            print(f"\n\n[*] Done: {stats['iterations']} iterations in "
                  f"{elapsed:.1f}s ({rate:.1f} exec/s)")
            print(f"    Corpus: {stats['corpus_size']} entries")
            print(f"    Crashes: {stats['crashes']}")
            print(f"    New edges: {stats['new_edges']}")
        except KeyboardInterrupt:
            pass
        for w in worker_dirs:
            shutil.rmtree(w["dir"], ignore_errors=True)


def main():
    print_banner(sys.stderr)
    parser = argparse.ArgumentParser(
        description="virtio-villain coverage fuzzer",
        formatter_class=ShortFirstHelpFormatter,
        add_help=False,
        epilog=(
            "examples\n"
            "  run-fuzz fuzz --vmm ./cloud-hypervisor -n 50000 -j 4\n"
            "        run the coverage fuzzing loop\n"
            "  run-fuzz triage --vmm ./cloud-hypervisor\n"
            "        replay crashes and group them by error class\n"
            "  run-fuzz gen-test target/crashes/blob --id B9000\n"
            "        turn a crash blob into a C test\n"
            "  run-fuzz cov-report --vmm ./cloud-hypervisor\n"
            "        build an HTML coverage report from the corpus\n"
        ),
    )
    sub = parser.add_subparsers(dest="command", title="commands",
                                metavar="<command>")

    # Give every subcommand the same short first help layout as the top
    # level parser so the option rendering does not depend on the host
    # Python version.
    _sub_add_parser = sub.add_parser

    def _add_parser(name, **kwargs):
        kwargs.setdefault("formatter_class", ShortFirstHelpFormatter)
        return _sub_add_parser(name, **kwargs)

    sub.add_parser = _add_parser

    # Shared VMM sanitizer flag as a "host" group. Kept in one place so
    # the registry and revert logic live in the run module.
    def _add_sysconfig(p):
        g = p.add_argument_group("host")
        g.add_argument(
            "--apply-sysconfig", action="store_true",
            help="Apply sanitizer host settings via sudo, "
                 "reverted on exit")

    # Append -h/--help last so the useful options lead each screen.
    def _add_help(p):
        g = p.add_argument_group("other")
        g.add_argument("-h", "--help", action="help",
                       default=argparse.SUPPRESS,
                       help="Show this help message and exit")

    _add_help(parser)

    # --- fuzz (default) ---
    p_fuzz = sub.add_parser("fuzz", help="Run the fuzzing loop",
                            add_help=False)
    g = p_fuzz.add_argument_group("target")
    g.add_argument("--vmm", required=True, metavar="PATH",
                   help="Path to the VMM binary (required)")
    g.add_argument("--kernel", default=None, metavar="PATH",
                   help="Guest kernel, auto-detected if omitted")
    g.add_argument("--disk", default=None, metavar="PATH",
                   help="Raw disk image, created in tmpdir if omitted")
    g = p_fuzz.add_argument_group("fuzzing")
    g.add_argument("-n", "--iterations", type=int, default=10000,
                   metavar="N",
                   help="Fuzzing iterations (default: 10000)")
    g.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                   metavar="DIR",
                   help="Directory for interesting inputs "
                        "(default: target/corpus)")
    g.add_argument("--crashes-dir",
                   default=os.path.join("target", "crashes"),
                   metavar="DIR",
                   help="Directory for crash inputs "
                        "(default: target/crashes)")
    g.add_argument("--no-coverage", action="store_true",
                   help="Skip coverage feedback (dumb fuzzing)")
    g.add_argument("--device", default=None,
                   choices=sorted(_DEVICE_MAP), metavar="DEV",
                   help="Focus fuzzing on one virtio device "
                        "(default: all devices in the corpus)")
    g = p_fuzz.add_argument_group("execution")
    g.add_argument("-j", "--jobs", type=int, default=1, metavar="N",
                   help="Parallel VMs (default: 1)")
    g.add_argument("--cpus", type=int, default=2, metavar="N",
                   help="vCPUs per VM (default: 2)")
    g.add_argument("--memory", default="128M",
                   type=_run_mod._normalize_mem, metavar="SIZE",
                   help="RAM per VM (default: 128M)")
    g.add_argument("--timeout", type=int, default=3, metavar="SEC",
                   help="VMM boot timeout in seconds (default: 3)")
    g.add_argument("--no-confirm-timeouts", action="store_true",
                   help="save timeouts as crashes without reconfirming "
                        "them with a longer timeout")
    _add_sysconfig(p_fuzz)
    _add_help(p_fuzz)

    # --- decode ---
    p_decode = sub.add_parser("decode", help="Decode and print crash blobs",
                              add_help=False)
    p_decode.add_argument("blobs", nargs="+", metavar="BLOB",
                          help="Blob files to decode")
    _add_help(p_decode)

    # --- gen-test ---
    p_gen = sub.add_parser("gen-test",
                           help="Generate a C test from a fuzz blob",
                           add_help=False)
    p_gen.add_argument("blob", metavar="BLOB",
                       help="Fuzz blob to convert")
    p_gen.add_argument("--device", default=None,
                       choices=sorted(_DEVICE_MAP), metavar="DEV",
                       help="Target virtio device, from first blob segment "
                            "if omitted")
    p_gen.add_argument("--id", default=None, metavar="ID",
                       help="Test ID like B9000, auto-picked if omitted")
    p_gen.add_argument("--force", action="store_true",
                       help="Overwrite existing test file")
    _add_help(p_gen)

    # --- replay ---
    p_replay = sub.add_parser("replay", help="Replay crash blobs against VMM",
                              add_help=False)
    p_replay.add_argument("--vmm", required=True, metavar="PATH",
                          help="Path to the VMM binary (required)")
    p_replay.add_argument("--kernel", default=None, metavar="PATH",
                          help="Guest kernel, auto-detected if omitted")
    p_replay.add_argument("--disk", default=None, metavar="PATH",
                          help="Raw disk image, created in tmpdir if omitted")
    p_replay.add_argument("--timeout", type=int, default=5, metavar="SEC",
                          help="VMM boot timeout in seconds (default: 5)")
    p_replay.add_argument("-v", "--verbose", action="store_true",
                          help="Print the full captured VMM stderr log")
    p_replay.add_argument("blobs", nargs="+", metavar="BLOB",
                          help="Blob files to replay")
    _add_sysconfig(p_replay)
    _add_help(p_replay)

    # --- seed ---
    p_seed = sub.add_parser("seed", help="Generate corpus from existing tests",
                            add_help=False)
    p_seed.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                        metavar="DIR",
                        help="Directory to write seeds into "
                             "(default: target/corpus)")
    _add_help(p_seed)

    # --- triage ---
    p_triage = sub.add_parser("triage", help="Replay and group crashes by error class",
                              add_help=False)
    p_triage.add_argument("--vmm", required=True, metavar="PATH",
                          help="Path to the VMM binary (required)")
    p_triage.add_argument("--kernel", default=None, metavar="PATH",
                          help="Guest kernel, auto-detected if omitted")
    p_triage.add_argument("--disk", default=None, metavar="PATH",
                          help="Raw disk image, created in tmpdir if omitted")
    p_triage.add_argument("--timeout", type=int, default=5, metavar="SEC",
                          help="VMM boot timeout in seconds (default: 5)")
    p_triage.add_argument("--crashes-dir",
                          default=os.path.join("target", "crashes"),
                          metavar="DIR",
                          help="Directory containing crash blobs "
                               "(default: target/crashes)")
    _add_sysconfig(p_triage)
    _add_help(p_triage)

    # --- minimize ---
    p_min = sub.add_parser("minimize", help="Remove corpus entries with redundant coverage",
                           add_help=False)
    p_min.add_argument("--vmm", required=True, metavar="PATH",
                       help="Path to the VMM binary (required)")
    p_min.add_argument("--kernel", default=None, metavar="PATH",
                       help="Guest kernel, auto-detected if omitted")
    p_min.add_argument("--timeout", type=int, default=3, metavar="SEC",
                       help="VMM boot timeout in seconds (default: 3)")
    p_min.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                       metavar="DIR",
                       help="Directory containing corpus blobs "
                            "(default: target/corpus)")
    p_min.add_argument("--dry-run", action="store_true",
                       help="Show what would be removed without deleting")
    _add_sysconfig(p_min)
    _add_help(p_min)

    # --- cov-report ---
    p_cov = sub.add_parser("cov-report", help="Generate HTML coverage report from corpus",
                           add_help=False)
    p_cov.add_argument("--vmm", required=True, metavar="PATH",
                       help="Path to the VMM binary (required)")
    p_cov.add_argument("--kernel", default=None, metavar="PATH",
                       help="Guest kernel, auto-detected if omitted")
    p_cov.add_argument("--timeout", type=int, default=3, metavar="SEC",
                       help="VMM boot timeout in seconds (default: 3)")
    p_cov.add_argument("--corpus-dir", default=os.path.join("target", "corpus"),
                       metavar="DIR",
                       help="Directory containing corpus blobs "
                            "(default: target/corpus)")
    p_cov.add_argument("-o", "--output",
                       default=os.path.join("target", "cov-report"),
                       metavar="DIR",
                       help="Output directory for the HTML report "
                            "(default: target/cov-report)")
    p_cov.add_argument("--no-profraw", action="store_true",
                       help="Skip merging target/profraw/ from test runs")
    _add_sysconfig(p_cov)
    _add_help(p_cov)

    args = parser.parse_args()

    if getattr(args, "apply_sysconfig", False):
        _run_mod.enable_sysconfigs(getattr(args, "vmm", None))

    if args.command == "decode":
        cmd_decode(args)
    elif args.command == "gen-test":
        cmd_gen_test(args)
    elif args.command == "replay":
        cmd_replay(args)
    elif args.command == "seed":
        cmd_seed(args)
    elif args.command == "triage":
        cmd_triage(args)
    elif args.command == "minimize":
        cmd_minimize(args)
    elif args.command == "cov-report":
        cmd_cov_report(args)
    elif args.command == "fuzz":
        cmd_fuzz(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
