def find_fuzz_section_offset(elf_path):
    """Find the file offset of .fuzz_input section in the ELF."""
    result = subprocess.run(
        ["readelf", "-S", elf_path],
        capture_output=True, text=True
    )
    for line in result.stdout.splitlines():
        if ".fuzz_input" in line:
            parts = line.split()
            # Section header: [Nr] Name Type Addr Off Size ...
            # The offset is typically the 5th or 6th field
            for i, p in enumerate(parts):
                if p == ".fuzz_input":
                    # Offset is 2 fields after the address
                    # Format: [22] .fuzz_input PROGBITS addr offset size ...
                    offset_str = parts[i + 3]  # skip Type, Addr → Offset
                    return int(offset_str, 16)
    return None


def patch_blob(elf_path, blob, section_offset):
    """Write blob bytes directly into the ELF at section offset."""
    with open(elf_path, "r+b") as f:
        f.seek(section_offset)
        f.write(blob)


def build_initramfs(fuzz_binary, output_path):
    """Build a minimal initramfs containing just the fuzz binary as /init."""
    tmpdir = tempfile.mkdtemp(prefix="vvfuzz_")
    try:
        for d in ["proc", "sys", "dev"]:
            os.makedirs(os.path.join(tmpdir, d))
        shutil.copy2(fuzz_binary, os.path.join(tmpdir, "init"))
        # Strip
        subprocess.run(["strip", os.path.join(tmpdir, "init")],
                       capture_output=True)
        # Build cpio
        find = subprocess.Popen(
            ["find", "."], cwd=tmpdir, stdout=subprocess.PIPE
        )
        cpio = subprocess.Popen(
            ["cpio", "-o", "-H", "newc"],
            cwd=tmpdir, stdin=find.stdout, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL
        )
        find.stdout.close()
        gzip = subprocess.Popen(
            ["gzip"], stdin=cpio.stdout, stdout=open(output_path, "wb"),
            stderr=subprocess.DEVNULL
        )
        cpio.stdout.close()
        gzip.wait()
        cpio.wait()
        find.wait()
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def _fetch_kernel():
    """Return path to guest kernel, downloading if not cached."""
    result = subprocess.run(
        [os.path.join(_SCRIPT_DIR, "run"), "fetch-kernel"],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        sys.exit(f"Failed to fetch kernel: {result.stderr.strip()}")
    return result.stdout.strip()


def _fuzz_vmm_cmd(vmm_path, kernel, initramfs_path, disk, pmem_path,
                  profraw_dir, cpus, memory):
    """Build the Cloud Hypervisor command used for a fuzz iteration."""
    global _fuzz_vsock_cid

    with _fuzz_vsock_cid_lock:
        cid = _fuzz_vsock_cid
        _fuzz_vsock_cid += 1
    vsock_path = os.path.join(profraw_dir, "fuzz.vsock")
    return [
        vmm_path,
        "--kernel", kernel,
        "--initramfs", initramfs_path,
        "--disk", f"path={disk},num_queues={cpus}",
        "--net", "tap=,num_queues=2",
        "--vsock", f"cid={cid},socket={vsock_path}",
        "--balloon", "size=0",
        "--watchdog",
        "--rng", "src=/dev/urandom",
        "--console", "null",
        "--pmem", f"file={pmem_path},size=128M,discard_writes=on",
        "--cpus", f"boot={cpus}",
        "--memory", (f"size={memory},hotplug_size=256M,"
                     "hotplug_method=virtio-mem"),
        "--serial", "off",
        "--cmdline", "console=hvc0 initcall_blacklist=virtio_blk_init",
        "--seccomp", "false",
    ]


def _require_vmm(vmm_path):
    """Exit with a clear message when the VMM binary is missing.

    A cross build puts the binary under target/<triple>/debug/, not
    target/debug/, which is a common path mistake.
    """
    if not os.path.isfile(vmm_path):
        sys.exit(f"error: VMM binary not found: {vmm_path}\n"
                 "       Check the --vmm path. A cross build puts it under "
                 "target/<triple>/debug/, not target/debug/.")
    if not os.access(vmm_path, os.X_OK):
        sys.exit(f"error: VMM binary is not executable: {vmm_path}")


def run_vmm(vmm_path, initramfs_path, profraw_dir, timeout=3,
            kernel_path=None, disk_path=None, cpus=2, memory="128M"):
    """Boot the VMM with the fuzz initramfs.

    Returns (exit_code, crashed, output, timed_out). A timeout under
    parallel load is not a genuine fault, so callers can reconfirm it.
    """
    if kernel_path:
        kernel = kernel_path
    else:
        kernel = _fetch_kernel()

    # Create a small disk image
    if disk_path:
        disk = disk_path
    else:
        disk = os.path.join(profraw_dir, "disk.raw")
    if not os.path.exists(disk):
        with open(disk, "wb") as f:
            f.seek(64 * 1024 * 1024 - 1)
            f.write(b"\x00")

    pmem_path = os.path.join(profraw_dir, "pmem.raw")
    if not os.path.exists(pmem_path):
        with open(pmem_path, "wb") as f:
            f.seek(128 * 1024 * 1024 - 1)
            f.write(b"\x00")

    env = os.environ.copy()
    env["LLVM_PROFILE_FILE"] = os.path.join(profraw_dir, "%p.profraw")

    cmd = _fuzz_vmm_cmd(vmm_path, kernel, initramfs_path, disk, pmem_path,
                        profraw_dir, cpus, memory)

    try:
        result = subprocess.run(
            cmd, timeout=timeout, capture_output=True, env=env
        )
        output = result.stderr.decode(errors="replace")
        # A non zero exit on its own is not a fault. The fuzz guest
        # reboots on a VMM without isa-debug-exit, and the VMM correctly
        # rejects malformed rings with NEEDS_RESET or a handled ERROR
        # log. Only a fatal signal, a sanitizer report, or a panic is a
        # genuine fault. _fault_class also filters the LeakSanitizer
        # ptrace teardown abort, which is a same uid ptrace EPERM at exit
        # rather than a real finding. Run with --apply-sysconfig to grant
        # CAP_SYS_PTRACE and remove that artifact at the source.
        crashed = _fault_class(result.returncode, output) is not None
        return result.returncode, crashed, output, False
    except subprocess.TimeoutExpired:
        return -1, True, "", True


